<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="1dp" android:insetRight="1dp"
    android:insetTop="1dp" android:insetBottom="1dp">
    <selector>
        <item android:state_pressed="true">
            <shape android:shape="rectangle">
                <solid android:color="@color/keyboard_key_pressed" />
                <stroke android:width="1dp" android:color="@color/keyboard_key_border" />
                <corners android:radius="5dp" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="@color/keyboard_key_bg" />
                <stroke android:width="1dp" android:color="@color/keyboard_key_border" />
                <corners android:radius="5dp" />
            </shape>
        </item>
    </selector>
</inset>
