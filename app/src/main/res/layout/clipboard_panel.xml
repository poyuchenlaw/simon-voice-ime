<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#111122">

    <!-- 標題列 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📋 剪貼簿"
            android:textColor="#e0e0e0"
            android:textSize="14sp"
            android:paddingStart="8dp" />

        <Button
            android:id="@+id/btnClipVocabList"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="詞彙"
            android:textColor="#4ECCA3"
            android:textSize="12sp"
            android:background="@android:color/transparent"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <Button
            android:id="@+id/btnClipClose"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="✕"
            android:textColor="#888888"
            android:textSize="14sp"
            android:background="@android:color/transparent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <!-- 剪貼簿列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/clipRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="4dp" />

    <!-- 標記底欄（有標記時顯示） -->
    <LinearLayout
        android:id="@+id/clipMarkFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/clipMarkCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#4ECCA3"
            android:textSize="12sp"
            android:paddingStart="8dp" />

        <Button
            android:id="@+id/btnClipSetAiContext"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="AI 語境"
            android:textColor="#a0a0ff"
            android:textSize="11sp"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/btnClipAddVocab"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="加詞彙"
            android:textColor="#4ECCA3"
            android:textSize="11sp"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/btnClipClearMark"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="清除"
            android:textColor="#888888"
            android:textSize="11sp"
            android:background="@android:color/transparent" />
    </LinearLayout>

</LinearLayout>
