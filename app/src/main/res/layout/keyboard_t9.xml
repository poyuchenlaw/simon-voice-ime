<?xml version="1.0" encoding="utf-8"?>
<com.simon.voiceime.SwipeInterceptLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/t9Keyboard" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:layout_marginBottom="3dp">
        <TextView android:id="@+id/t9Preview" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|start" android:paddingStart="10dp" android:text="輸入預覽" android:textSize="19sp" android:textColor="@color/key_text" android:background="@color/key_bg" android:singleLine="true" android:ellipsize="start" android:tag="keyboardSwipeExcluded"/>
        <TextView android:id="@+id/t9Mode" android:layout_width="52dp" android:layout_height="match_parent" android:layout_marginStart="3dp" android:gravity="center" android:text="兩按" android:textSize="14sp" android:textColor="@color/key_text" android:background="@color/key_bg"/>
        <TextView android:id="@+id/t9Backspace" android:layout_width="52dp" android:layout_height="match_parent" android:layout_marginStart="3dp" android:gravity="center" android:text="⌫" android:textSize="20sp" android:textColor="@color/key_text" android:background="@color/key_bg"/>
    </LinearLayout>
    <HorizontalScrollView android:id="@+id/t9CandidateScroll" android:layout_width="match_parent" android:layout_height="40dp" android:scrollbars="none" android:tag="keyboardSwipeExcluded" android:layout_marginBottom="3dp">
        <LinearLayout android:id="@+id/t9Candidates" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal"/>
    </HorizontalScrollView>
    <TextView android:id="@+id/t9AiSuggestion" android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center_vertical|start" android:paddingStart="10dp" android:text="" android:textSize="16sp" android:textColor="@color/key_text" android:background="#23414f56" android:visibility="gone" android:tag="keyboardSwipeExcluded" android:layout_marginBottom="3dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginBottom="3dp">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:gravity="center" android:text="1\nㄅㄆㄇㄈ" android:textSize="14sp" android:textColor="@color/key_text" android:background="@color/key_bg" android:tag="t9:1"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:gravity="center" android:text="2\nㄉㄊㄋㄌ" android:textSize="14sp" android:textColor="@color/key_text" android:background="@color/key_bg" android:tag="t9:2"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="3\nㄍㄎㄏ" android:textSize="14sp" android:textColor="@color/key_text" android:background="@color/key_bg" android:tag="t9:3"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginBottom="3dp">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:gravity="center" android:text="4\nㄐㄑㄒ" android:textSize="14sp" android:textColor="@color/key_text" android:background="@color/key_bg" android:tag="t9:4"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:gravity="center" android:text="5\nㄓㄔㄕㄖ" android:textSize="14sp" android:textColor="@color/key_text" android:background="@color/key_bg" android:tag="t9:5"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="6\nㄗㄘㄙ" android:textSize="14sp" android:textColor="@color/key_text" android:background="@color/key_bg" android:tag="t9:6"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginBottom="3dp">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:gravity="center" android:text="7\nㄧㄨㄩ" android:textSize="14sp" android:textColor="@color/key_text" android:background="@color/key_bg" android:tag="t9:7"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:gravity="center" android:text="8\nㄚㄛㄜㄝ\nㄞㄟㄠㄡ" android:textSize="12sp" android:textColor="@color/key_text" android:background="@color/key_bg" android:tag="t9:8"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="9\nㄢㄣㄤㄥㄦ" android:textSize="14sp" android:textColor="@color/key_text" android:background="@color/key_bg" android:tag="t9:9"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
        <TextView android:id="@+id/t9To41" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:layout_marginEnd="2dp" android:gravity="center" android:text="41鍵" android:textSize="13sp" android:textColor="@color/key_text" android:background="@color/key_bg"/>
        <TextView android:id="@+id/t9Comma" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:gravity="center" android:text="，" android:textSize="18sp" android:textColor="@color/key_text" android:background="@color/key_bg"/>
        <TextView android:id="@+id/t9Space" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2.2" android:layout_marginEnd="2dp" android:gravity="center" android:text="空白" android:textSize="14sp" android:textColor="@color/key_text" android:background="@color/key_bg"/>
        <TextView android:id="@+id/t9Period" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:gravity="center" android:text="。" android:textSize="18sp" android:textColor="@color/key_text" android:background="@color/key_bg"/>
        <TextView android:id="@+id/t9Enter" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:gravity="center" android:text="↵" android:textSize="18sp" android:textColor="#8fbc8f" android:background="#1b3326"/>
    </LinearLayout>
</com.simon.voiceime.SwipeInterceptLayout>
