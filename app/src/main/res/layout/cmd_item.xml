<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_marginBottom="2dp"
    android:clickable="true"
    android:focusable="true"><tag android:id="@id/keyboard_role" android:value="background" /><tag android:id="@id/keyboard_text_role" android:value="text" /><tag android:id="@id/keyboard_content_kind" android:value="content" />

    <TextView
        android:id="@+id/cmdLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"  android:fontFamily="sans-serif"><tag android:id="@id/keyboard_role" android:value="background" /><tag android:id="@id/keyboard_text_role" android:value="text" /><tag android:id="@id/keyboard_content_kind" android:value="content" /></TextView>

    <TextView
        android:id="@+id/cmdText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="2dp"  android:fontFamily="sans-serif"><tag android:id="@id/keyboard_role" android:value="background" /><tag android:id="@id/keyboard_text_role" android:value="secondary" /><tag android:id="@id/keyboard_content_kind" android:value="content" /></TextView>

</LinearLayout>
