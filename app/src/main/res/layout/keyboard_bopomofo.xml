<?xml version="1.0" encoding="utf-8"?>
<com.simon.voiceime.KeyboardTouchLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bopomofoKeyboard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="3dp"
    android:paddingEnd="3dp"
    android:paddingBottom="3dp">

    <TextView android:id="@+id/boCompleteTypingHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/zhuyin_complete_typing_hint" android:textSize="13sp" android:textColor="@color/key_text" android:padding="6dp" android:visibility="gone"/>

    <HorizontalScrollView android:id="@+id/boStreamPreviewScroll" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="2dp" android:fillViewport="true" android:scrollbars="none">
        <com.simon.voiceime.PreviewCursorView android:id="@+id/boStreamPreview" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="21sp" android:textColor="@color/key_text" android:background="@color/key_bg" android:singleLine="true" android:ellipsize="none"/>
    </HorizontalScrollView>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="26dp" android:scrollbars="none">
        <com.simon.voiceime.PreviewCursorView android:id="@+id/boPhoneticPreview" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="15sp" android:textColor="@color/key_text" android:singleLine="true"/>
    </HorizontalScrollView>
    <LinearLayout android:id="@+id/boCandidateBar" android:layout_width="match_parent" android:layout_height="38dp" android:orientation="horizontal" android:layout_marginBottom="2dp">
        <TextView android:id="@+id/boCursorLeft" android:layout_width="38dp" android:layout_height="match_parent" android:gravity="center" android:text="◀" android:textSize="15sp" android:textColor="@color/key_text" android:background="@color/key_bg" android:layout_marginEnd="2dp"/>
        <HorizontalScrollView android:id="@+id/boCandidateScroll" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:fillViewport="false" android:scrollbars="none">
            <LinearLayout android:id="@+id/boCandidateItems" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal"/>
        </HorizontalScrollView>
        <TextView android:id="@+id/boCursorRight" android:layout_width="38dp" android:layout_height="match_parent" android:gravity="center" android:text="▶" android:textSize="15sp" android:textColor="@color/key_text" android:background="@color/key_bg" android:layout_marginStart="2dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="39dp" android:orientation="horizontal" android:layout_marginBottom="2dp">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄅ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄅ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄉ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄉ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ˇ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ˇ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ˋ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ˋ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄓ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄓ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ˊ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ˊ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="˙" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:˙"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄚ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄚ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄞ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄞ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄢ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄢ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄦ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄦ"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="39dp" android:orientation="horizontal" android:layout_marginBottom="2dp">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄆ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄆ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄊ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄊ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄍ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄍ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄐ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄐ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄔ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄔ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄗ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄗ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄧ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄧ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄛ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄛ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄟ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄟ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄣ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄣ"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="39dp" android:orientation="horizontal" android:layout_marginBottom="2dp">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄇ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄇ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄋ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄋ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄎ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄎ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄑ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄑ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄕ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄕ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄘ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄘ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄨ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄨ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄜ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄜ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄠ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄠ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄤ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄤ"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="39dp" android:orientation="horizontal" android:layout_marginBottom="2dp">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄈ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄈ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄌ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄌ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄏ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄏ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄒ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄒ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄖ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄖ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄙ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄙ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄩ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄩ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄝ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄝ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄡ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄡ"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="ㄥ" android:textSize="18sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:ㄥ"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:orientation="horizontal">
        <TextView android:layout_width="44dp" android:layout_height="match_parent" android:gravity="center" android:text="EN" android:textSize="14sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:layout_marginEnd="2dp" android:tag="key:toEnglish"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.3" android:gravity="center" android:text="🎤" android:textSize="16sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:layout_marginEnd="2dp" android:tag="key:toVoice"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.3" android:gravity="center" android:text="123" android:textSize="14sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:layout_marginEnd="2dp" android:tag="key:toNumbers"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:gravity="center" android:text="，" android:textSize="16sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:layout_marginEnd="2dp" android:tag="key:comma"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="4" android:gravity="center" android:text="空白" android:textSize="15sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:layout_marginEnd="2dp" android:tag="key:space"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.3" android:gravity="center" android:text="⌫" android:textSize="16sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:layout_marginEnd="2dp" android:tag="key:backspace"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.3" android:gravity="center" android:text="↵" android:textSize="16sp" android:textColor="@color/keyboard_key_text" android:background="@drawable/keyboard_key" android:tag="key:enter"/>
    </LinearLayout>
</com.simon.voiceime.KeyboardTouchLayout>
