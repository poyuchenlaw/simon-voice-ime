<?xml version="1.0" encoding="utf-8"?>
<com.simon.voiceime.KeyboardInputLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <tag android:id="@id/keyboard_role" android:value="background" />

    <!-- 彈出面板容器（剪貼簿/常用指令），預設隱藏 -->
    <FrameLayout
        android:id="@+id/panelContainer"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:visibility="gone">
        <tag android:id="@id/keyboard_role" android:value="background" />
    </FrameLayout>

    <!-- 狀態列（錄音時才顯示） -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="11sp"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="1dp"
        android:visibility="gone">
        <tag android:id="@id/keyboard_role" android:value="background" />
        <tag android:id="@id/keyboard_text_role" android:value="secondary" />
        <tag android:id="@id/keyboard_content_kind" android:value="content" />
    </TextView>

    <TextView
        android:id="@+id/pendingVoiceCandidateNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:gravity="center"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone">
        <tag android:id="@id/keyboard_role" android:value="background" />
        <tag android:id="@id/keyboard_text_role" android:value="text" />
        <tag android:id="@id/keyboard_content_kind" android:value="content" />
    </TextView>
    <Button
        android:id="@+id/notificationEntry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">
        <tag android:id="@id/keyboard_role" android:value="background" />
        <tag android:id="@id/keyboard_text_role" android:value="text" />
        <tag android:id="@id/keyboard_content_kind" android:value="content" />
    </Button>

    <!-- 預覽文字 -->
    <TextView
        android:id="@+id/previewText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:gravity="center"
        android:visibility="gone">
        <tag android:id="@id/keyboard_role" android:value="background" />
        <tag android:id="@id/keyboard_text_role" android:value="text" />
        <tag android:id="@id/keyboard_content_kind" android:value="content" />
    </TextView>

    <!-- ========== 語音鍵盤（預設顯示） ========== -->
    <com.simon.voiceime.KeyboardTouchLayout
        android:id="@+id/voiceKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="3dp"
        android:paddingEnd="2dp"
        android:paddingBottom="3dp">
            <tag android:id="@id/keyboard_role" android:value="background" />
            <tag android:id="@id/keyboard_text_role" android:value="text" />

        <!-- 左側：功能列 + 編輯列 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:orientation="vertical">
                <tag android:id="@id/keyboard_role" android:value="background" />
                <tag android:id="@id/keyboard_text_role" android:value="text" />

            <!-- Row 1：功能列 — ⚙ 全 半 📋 ⚡ 追 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">
                <tag android:id="@id/keyboard_role" android:value="background" />
                <tag android:id="@id/keyboard_text_role" android:value="text" />



                <TextView
                    android:id="@+id/btnSettings"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="⚙"
                    android:textSize="14sp"
                    android:layout_marginEnd="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <tag android:id="@id/keyboard_role" android:value="tools" />
                    <tag android:id="@id/keyboard_text_role" android:value="secondary" />
                    <tag android:id="@id/keyboard_visible_inset" android:value="0" />
                </TextView>

                <TextView
                    android:id="@+id/btnFullWidth"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="全"
                    android:textSize="12sp"
                    android:layout_marginEnd="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <tag android:id="@id/keyboard_role" android:value="tools" />
                    <tag android:id="@id/keyboard_text_role" android:value="secondary" />
                    <tag android:id="@id/keyboard_visible_inset" android:value="0" />
                </TextView>

                <TextView
                    android:id="@+id/btnHalfWidth"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="半"
                    android:textSize="12sp"
                    android:layout_marginEnd="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <tag android:id="@id/keyboard_role" android:value="tools" />
                    <tag android:id="@id/keyboard_text_role" android:value="secondary" />
                    <tag android:id="@id/keyboard_visible_inset" android:value="0" />
                </TextView>

                <TextView
                    android:id="@+id/btnClipboard"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="📋"
                    android:textSize="14sp"
                    android:layout_marginEnd="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <tag android:id="@id/keyboard_role" android:value="tools" />
                    <tag android:id="@id/keyboard_text_role" android:value="secondary" />
                    <tag android:id="@id/keyboard_visible_inset" android:value="0" />
                </TextView>

                <TextView
                    android:id="@+id/btnCommands"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="⚡"
                    android:textSize="14sp"
                    android:layout_marginEnd="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <tag android:id="@id/keyboard_role" android:value="tools" />
                    <tag android:id="@id/keyboard_text_role" android:value="secondary" />
                    <tag android:id="@id/keyboard_visible_inset" android:value="0" />
                </TextView>

                <TextView
                    android:id="@+id/btnMode"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="追"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true">
                    <tag android:id="@id/keyboard_role" android:value="tools" />
                    <tag android:id="@id/keyboard_text_role" android:value="mode_append" />
                    <tag android:id="@id/keyboard_visible_inset" android:value="0" />
                </TextView>

            </LinearLayout>

            <!-- Row 2：編輯列 — 注 ␣ ， 。 ⌫ ↵ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnSwitchIME"
                    android:layout_width="44dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="注"
                    android:textSize="12sp"
                    android:layout_marginEnd="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <tag android:id="@id/keyboard_role" android:value="tools" />
                    <tag android:id="@id/keyboard_text_role" android:value="hint" />
                    <tag android:id="@id/keyboard_visible_inset" android:value="0" />
                </TextView>

                <TextView
                    android:id="@+id/btnSpace"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="␣"
                    android:textSize="16sp"
                    android:layout_marginEnd="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <tag android:id="@id/keyboard_role" android:value="tools" />
                    <tag android:id="@id/keyboard_text_role" android:value="text" />
                    <tag android:id="@id/keyboard_visible_inset" android:value="0" />
                </TextView>

                <TextView
                    android:id="@+id/btnComma"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="，"
                    android:textSize="12sp"
                    android:layout_marginEnd="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <tag android:id="@id/keyboard_role" android:value="tools" />
                    <tag android:id="@id/keyboard_text_role" android:value="text" />
                    <tag android:id="@id/keyboard_visible_inset" android:value="0" />
                </TextView>

                <TextView
                    android:id="@+id/btnPeriod"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="。"
                    android:textSize="12sp"
                    android:layout_marginEnd="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <tag android:id="@id/keyboard_role" android:value="tools" />
                    <tag android:id="@id/keyboard_text_role" android:value="text" />
                    <tag android:id="@id/keyboard_visible_inset" android:value="0" />
                </TextView>

                <TextView
                    android:id="@+id/btnBackspace"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="⌫"
                    android:textSize="16sp"
                    android:layout_marginEnd="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <tag android:id="@id/keyboard_role" android:value="tools" />
                    <tag android:id="@id/keyboard_text_role" android:value="text" />
                    <tag android:id="@id/keyboard_visible_inset" android:value="0" />
                </TextView>

                <TextView
                    android:id="@+id/btnEnter"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="↵"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true">
                    <tag android:id="@id/keyboard_role" android:value="core" />
                    <tag android:id="@id/keyboard_text_role" android:value="text" />
                    <tag android:id="@id/keyboard_visible_inset" android:value="0" />
                </TextView>

                <tag android:id="@id/keyboard_role" android:value="background" />
                <tag android:id="@id/keyboard_text_role" android:value="text" />
            </LinearLayout>

        </LinearLayout>

        <!-- 右側：大麥克風按鈕（跨兩列） -->
        <Button
            android:id="@+id/btnMic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:text="🎤"
            android:textSize="28sp">
                <tag android:id="@id/keyboard_role" android:value="core" />
                <tag android:id="@id/keyboard_text_role" android:value="text" />
                <tag android:id="@id/keyboard_visible_inset" android:value="0" />
            </Button>

    </com.simon.voiceime.KeyboardTouchLayout>

    <!-- ========== 英文鍵盤（預設隱藏） ========== -->
    <include
        layout="@layout/keyboard_english"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- ========== 注音鍵盤（手打為個人詞庫金標） ========== -->
    <include
        layout="@layout/keyboard_bopomofo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />


    <!-- ========== 數字符號鍵盤（預設隱藏） ========== -->
    <include
        layout="@layout/keyboard_numbers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</com.simon.voiceime.KeyboardInputLayout>
