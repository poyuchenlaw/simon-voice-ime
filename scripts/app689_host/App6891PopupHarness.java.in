 @Test public void stopCursorMonitoringClearsPageAndRequestsZero(){dualHandPage=new Page();dualHandStopCursorUpdates();assertNull(dualHandPage.anchor);assertEquals(1,dualHandPage.clears);assertEquals(List.of(0),connection.requests);}
 @Test public void finishInputViewStopsMonitoring(){dualHandPage=new Page();finishInputView();assertNull(dualHandPage.anchor);assertEquals(List.of(0),connection.requests);}
 @Test public void clearingAnchorDismissesMarkerAndOldTap(){anchor=new Object();lastTapOwner=new Object();markerPopup=new PopupWindow(marker,84,63,false);markerPopup.showing=true;PopupWindow shown=markerPopup;markerExpiry=()->{};cursorAnchor(null);assertNull(anchor);assertNull(lastTapOwner);assertNull(marker);assertNull(markerPopup);assertFalse(shown.isShowing());assertNull(markerExpiry);assertEquals(1,ui.removes);}
 @Test public void stoppingUnsupportedOrAbsentHostStillClearsPage(){dualHandPage=new Page();connection.throwsUnsupported=true;dualHandStopCursorUpdates();assertNull(dualHandPage.anchor);connection.requests.clear();noConnection=true;dualHandStopCursorUpdates();assertTrue(connection.requests.isEmpty());}
 @Test public void bubbleNonzeroOriginMapsOnce(){bubblePosition();assertEquals(436,bubble.x);assertEquals(1952,bubble.y);bubblePosition();assertEquals(1952,bubble.y);}
 @Test public void bubbleFourEdgesStayInsideDisplay(){for(float x:new float[]{-100,0,500,2000})for(float y:new float[]{-2000,0,900,2400}){touch.lastX=x;touch.lastY=y;bubble.dismiss();bubblePosition();assertTrue("x="+bubble.x,bubble.x>=0&&bubble.x+163<=1050);assertTrue("y="+bubble.y,bubble.y>=0&&bubble.y+163<=2376);}}
 @Test public void bubbleNeverBlursHost(){bubblePosition();assertEquals(0,bubble.flags);}
 @Test public void capsuleIdentityTranslatedScaledUseScreenBoundsOnce(){
  // Hand-computed affine results: identity; +120,+900; 2x,+80,+850. Host origin is already in mapped bounds.
  float[][] mapped={{100,900,100,950},{220,1800,220,1850},{280,2650,280,2750}};
  int[][] expected={{58,848},{178,1748},{238,2313}};
  for(int i=0;i<mapped.length;i++){float[] b=mapped[i];bounds=new RectF(b[0],b[1],b[2],b[3]);markerPosition();assertEquals(expected[i][0],markerPopup.x,4*density);assertEquals(expected[i][1],markerPopup.y,4*density);}
 }
 @Test public void capsuleRespectsStatusBarAndEightDpGap(){root.visibleTop=63;bounds=new RectF(525,89,525,170);markerPosition();assertTrue("top input flips below",markerPopup.y>=159&&markerPopup.y<=170);assertTrue((markerPopup.y+height/2f-170)/density<=8);bounds=new RectF(525,880,525,961);markerPosition();assertEquals(525,markerPopup.x+width/2f,.001f);assertTrue("center gap <=8dp",(880-markerPopup.y-height/2f)/density<=8);}
 @Test public void capsuleTopFlipsBelow(){bounds=new RectF(100,10,100,60);markerPosition();assertEquals(50,markerPopup.y,4*density);}
 @Test public void cursorRequestedOnEveryInputRestartAndInactiveDoesNotRequest(){onStartInput(new EditorInfo(),false);onStartInput(new EditorInfo(),true);assertEquals(List.of(3,3),connection.requests);connection.requests.clear();dualHandSelected=false;onStartInput(new EditorInfo(),false);assertTrue(connection.requests.isEmpty());}
 @Test public void api26AlsoMapsCoordinatesOnce(){Build.VERSION.SDK_INT=26;try{bubblePosition();assertEquals(1952,bubble.y);bounds=new RectF(100,900,100,950);markerPosition();assertEquals(848,markerPopup.y,4*density);}finally{Build.VERSION.SDK_INT=34;}}
 @Test public void consumedAncestorStillAppliesRootInsetsOnLayout(){root.insets=new WindowInsets(84);layout(root,0,0,1050,944,0,0,1050,944);assertEquals(92,root.pad);root.insets=new WindowInsets(0);layout(root,0,0,1050,944,0,0,1050,944);assertEquals(8,root.pad);}
 @Test public void paddingIsBasePlusInsetAcrossThemesAndRepeatedDispatch(){for(int inset:new int[]{84,84,0,84,0}){inset(new WindowInsets(inset));for(int i=0;i<3;i++){applyPalette();assertEquals(8+inset,root.pad);}}}
