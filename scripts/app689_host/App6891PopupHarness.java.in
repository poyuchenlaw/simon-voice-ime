 final Service service=new Service();final View root=new View(),bubbleLabel=new View();View marker=new View(),rootView=root;final Handler ui=new Handler();Object anchor=new Object(),lastTapOwner=new Object();Runnable markerExpiry;final Keyboard keyboard=new Keyboard();final Touch touch=new Touch();final InputConnection connection=new InputConnection();PopupWindow bubble=new PopupWindow(bubbleLabel,163,163,false),markerPopup;RectF bounds;float density=2.625f,labelSizeSp=12;int width=84,height=63,safeInset;String value="字";Page dualHandPage;boolean dualHandSelected=true,split,noConnection;Monitor mainDispatchMonitor;
