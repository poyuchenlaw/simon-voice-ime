package com.simon.voiceime;
import java.util.*;import java.io.*;import java.nio.charset.StandardCharsets;import org.json.JSONObject;import org.junit.Test;import static org.junit.Assert.*;
/** Executes shared production bodies against only OS/asset/View boundary fakes. Not pixel evidence. */
public class App690ASharedHarness {
 static class R {static class id {static int keyboard_haptic_gate=1,keyboard_role=2,keyboard_text_role=3,keyboard_style_theme=4,keyboard_visible_inset=5,keyboard_content_kind=6;} }
 static class Configuration {static int UI_MODE_NIGHT_MASK=48,UI_MODE_NIGHT_YES=32;int uiMode=32;}
 static class Metrics {float density=2.625f,scaledDensity=3.4125f;}
 static class Resources {Metrics m=new Metrics();Configuration conf=new Configuration();Metrics getDisplayMetrics(){return m;}Configuration getConfiguration(){return conf;} }
 static class SharedPreferences {Map<String,Object> flags=new HashMap<>();boolean getBoolean(String k,boolean d){return (Boolean)flags.getOrDefault(k,d);}String getString(String k,String d){return (String)flags.getOrDefault(k,d);} }
 static class Assets {InputStream open(String path)throws IOException{return new FileInputStream("app/src/phone/assets/"+path);} }
 static class Context {SharedPreferences p=new SharedPreferences();Resources r=new Resources();Assets getAssets(){return new Assets();}SharedPreferences getSharedPreferences(String n,int m){return p;}Resources getResources(){return r;} }
 static class Typeface {static Typeface DEFAULT=new Typeface();static int assetReads;static Typeface createFromAsset(Assets assets,String path)throws IOException{assetReads++;if(Boolean.getBoolean("app690a.fontMissing"))throw new IOException("synthetic missing asset");try(InputStream in=assets.open(path)){assertTrue(in.read()>=0);}return new Typeface();} }
 static class TextPaint {Typeface face=Typeface.DEFAULT;void setTypeface(Typeface f){face=f;} }
 static abstract class MetricAffectingSpan {public abstract void updateDrawState(TextPaint p);public abstract void updateMeasureState(TextPaint p);}static class Spanned{static int SPAN_EXCLUSIVE_EXCLUSIVE=33;}
 static class SpannableString implements CharSequence {String s;List<int[]> ranges=new ArrayList<>();List<MetricAffectingSpan> spans=new ArrayList<>();SpannableString(CharSequence s){this.s=s.toString();}void setSpan(MetricAffectingSpan span,int a,int b,int flags){ranges.add(new int[]{a,b});spans.add(span);}public int length(){return s.length();}public char charAt(int i){return s.charAt(i);}public CharSequence subSequence(int a,int b){return s.subSequence(a,b);}public String toString(){return s;} }
 static class android {static class util{static class Log{static int warnings;static void w(String tag,String msg,Exception e){warnings++;}}} }
 static class Build {static class VERSION{static int SDK_INT=34;} }
 static class HapticFeedbackConstants {static final int KEYBOARD_TAP=3,CLOCK_TICK=4,REJECT=17,LONG_PRESS=0;}
 static class Gravity {static int CENTER=17;}
 static class GradientDrawable {int color;float radius;void setColor(int c){color=c;}void setCornerRadius(float r){radius=r;} }
 static class View {static int VISIBLE=0;Context context;Map<Integer,Object> tags=new HashMap<>();Object tag;boolean enabled=true,longClickable=true,clickable;int color;List<Integer> emitted=new ArrayList<>();View(Context c){context=c;}Context getContext(){return context;}Resources getResources(){return context.r;}Object getTag(){return tag;}Object getTag(int id){return tags.get(id);}void setTag(int id,Object value){tags.put(id,value);}void setHapticFeedbackEnabled(boolean b){enabled=b;}boolean isHapticFeedbackEnabled(){return enabled;}boolean isLongClickable(){return longClickable;}boolean performHapticFeedback(int event){if(enabled)emitted.add(event);return enabled;}int getVisibility(){return VISIBLE;}Object getBackground(){return null;}boolean isClickable(){return clickable;}void setBackgroundColor(int c){color=c;} }
 static class ViewGroup extends View {List<View> children=new ArrayList<>();ViewGroup(Context c){super(c);}int getChildCount(){return children.size();}View getChildAt(int i){return children.get(i);} }
 static class TextView extends View {Typeface face;float sp;int fg,left,right;boolean singleLine,selected,padding;GradientDrawable bg;TextView(Context c){super(c);}String getText(){return "詞格";}void setTypeface(Typeface f){face=f;}void setTextSize(float s){sp=s;}void setTextColor(int c){fg=c;}void setGravity(int g){}void setSingleLine(boolean b){singleLine=b;}void setEllipsize(Object v){}void setIncludeFontPadding(boolean b){padding=b;}void setPadding(int l,int t,int r,int b){left=l;right=r;}void setBackground(GradientDrawable d){bg=d;}void setSelected(boolean b){selected=b;} }
 static class MotionEvent {static int ACTION_DOWN=0,ACTION_UP=1,ACTION_MOVE=2,ACTION_CANCEL=3;}
 static class KeyboardKeycaps {static class Cap{}static void press(View v){}static void release(View v){}static void apply(View v,boolean dark,String role,float inset){v.color=DualHandVisuals.color(dark,role);} }
 static class KeyboardTheme {static boolean isDark(String mode,boolean system){return "dark".equals(mode)||!"light".equals(mode)&&system;} }
 /* ROUTED_PRESS */
 /* CLASSIFY */
 /* FONT */
 /* HAPTICS */
 /* ROLES */
 /* CANDIDATES */
 @Test public void r1f_r8d_loadOnceAcrossThirtyReopens(){Context c=new Context();Typeface f=KeyboardTypeface.get(c);for(int i=0;i<30;i++)assertSame(f,KeyboardTypeface.get(c));assertEquals(1,KeyboardTypeface.loadCount());assertEquals(1,Typeface.assetReads);if(Boolean.getBoolean("app690a.fontMissing")){assertSame(Typeface.DEFAULT,f);assertEquals(1,android.util.Log.warnings);}else assertTrue(KeyboardTypeface.bundled(f));}
 @Test public void a2_5_openContentAndPhoneticSpan(){Context c=new Context();assertSame(Typeface.DEFAULT,KeyboardTypeface.forLabel(c,"𪚥自訂名稱",false));SpannableString s=(SpannableString)KeyboardTypeface.mixed(c,"行ㄒㄧㄥˊA");assertEquals(4,s.spans.size());for(int[] bounds:s.ranges){assertTrue(bounds[0]>=1&&bounds[1]<=5);}assertTrue(KeyboardTypeface.phonetic('ˊ'));assertFalse(KeyboardTypeface.phonetic('行'));if(!Boolean.getBoolean("app690a.fontMissing")){assertEquals("bundled",KeyboardTypeface.classification(c,"⬆",true));assertEquals("bundled",KeyboardTypeface.classification(c,"␣",true));assertEquals("system",KeyboardTypeface.classification(c,"⌫",true));assertTrue(KeyboardTypeface.bundled(KeyboardTypeface.forLabel(c,"↵",true,true)));assertEquals("bundled",KeyboardTypeface.classification(c,"📋 剪貼簿",true));assertEquals("system",KeyboardTypeface.classification(c,"𪚥",true));}}
 @Test public void r5a_dualGateSequenceAndLegacyReject(){Context c=new Context();View v=new View(c);KeyboardHaptics.press(v);for(int i=0;i<3;i++)KeyboardHaptics.lock(v);KeyboardHaptics.reject(v);assertEquals(List.of(3,4,4,4,17),v.emitted);for(String gate:List.of("haptic_enabled","dual_hand_haptics")){int beforeCalls=KeyboardHaptics.callCount();v.emitted.clear();c.p.flags.put(gate,false);KeyboardHaptics.press(v);KeyboardHaptics.lock(v);KeyboardHaptics.reject(v);assertTrue(v.emitted.isEmpty());assertEquals(beforeCalls,KeyboardHaptics.callCount());c.p.flags.put(gate,true);}Build.VERSION.SDK_INT=29;try{KeyboardHaptics.reject(v);assertEquals(List.of(0),v.emitted);}finally{Build.VERSION.SDK_INT=34;}}
 @Test public void r5a_routedDownAndHoldRepeatsEmitOnlyOnce(){Context c=new Context();View v=new View(c);dispatchPrefix(0,v);for(int i=0;i<100;i++)dispatchPrefix(2,v);dispatchPrefix(1,v);assertEquals(List.of(3),v.emitted);}
 @Test public void a2_9_syncWholeTreeOnlyWhenGateChanges(){Context c=new Context();ViewGroup root=new ViewGroup(c),nested=new ViewGroup(c);View child=new View(c);root.children.add(nested);nested.children.add(child);c.p.flags.put("dual_hand_haptics",false);int start=KeyboardHaptics.syncCount();KeyboardHaptics.sync(c,root);assertEquals(start+1,KeyboardHaptics.syncCount());assertFalse(root.enabled);assertFalse(nested.enabled);assertFalse(child.enabled);for(int i=0;i<30;i++)KeyboardHaptics.sync(c,root);assertEquals(start+1,KeyboardHaptics.syncCount());c.p.flags.put("dual_hand_haptics",true);KeyboardHaptics.sync(c,root);assertTrue(child.enabled);assertEquals(start+2,KeyboardHaptics.syncCount());}
 @Test public void r8d_reopenSameThemeNoReapply(){Context c=new Context();ViewGroup root=new ViewGroup(c);TextView key=new TextView(c);root.children.add(key);KeyboardRoles.mark(root,"background","text");KeyboardRoles.mark(key,"tools","text");KeyboardRoles.apply(c,root);int count=KeyboardRoles.reapplyCount();for(int i=0;i<30;i++)KeyboardRoles.apply(c,root);assertEquals(count,KeyboardRoles.reapplyCount());c.r.conf.uiMode=16;KeyboardRoles.apply(c,root);assertEquals(count+2,KeyboardRoles.reapplyCount());assertEquals(DualHandVisuals.color(false,"text"),key.fg);}
 @Test public void run1_2_candidateHelperHasOneCompleteStyle(){Context c=new Context();for(boolean dark:new boolean[]{false,true})for(boolean selected:new boolean[]{false,true}){TextView v=new TextView(c);KeyboardCandidates.apply(v,dark,selected);assertEquals(19,v.sp,0);assertSame(Typeface.DEFAULT,v.face);assertEquals(DualHandVisuals.color(dark,"text"),v.fg);assertEquals(DualHandVisuals.color(dark,selected?"highlight":"background"),v.color);assertEquals(12,v.left);assertTrue(v.singleLine);assertEquals(selected,v.selected);}assertEquals(18,KeyboardCandidates.GRID_TEXT_SP,0);}
}
