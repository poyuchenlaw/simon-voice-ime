package com.simon.voiceime;
import java.util.*;import org.junit.Test;import static org.junit.Assert.*;
/** Executes the factory's draw commands; raster/Android shadow verification remains X1. */
public class App690AFactoryHarness {
 static class R {static class id{static int keyboard_role=1,keyboard_visible_inset=2,keyboard_keycap_factory=3;} }
 static class Rect {int left,top,right,bottom;Rect(){}Rect(Rect r){set(r.left,r.top,r.right,r.bottom);}void set(int l,int t,int r,int b){left=l;top=t;right=r;bottom=b;}void inset(int x,int y){left+=x;right-=x;top+=y;bottom-=y;} }
 static class Outline {Rect rect;float radius,alpha;void setAlpha(float value){alpha=value;}void setRoundRect(Rect r,float value){rect=r;radius=value;} }
 static class Paint {static int ANTI_ALIAS_FLAG=1;int color;float stroke;Paint(int flags){}void setColor(int c){color=c;}void setStrokeWidth(float s){stroke=s;} }
 static class Canvas {List<float[]> lines=new ArrayList<>();List<Integer> colors=new ArrayList<>();void drawLine(float a,float b,float c,float d,Paint p){lines.add(new float[]{a,b,c,d,p.stroke});colors.add(p.color);} }
 static class ColorFilter{}
 static class Drawable {Rect bounds=new Rect();void setBounds(Rect r){bounds=new Rect(r);onBoundsChange(bounds);}void setBounds(int l,int t,int r,int b){Rect value=new Rect();value.set(l,t,r,b);setBounds(value);}Rect getBounds(){return bounds;}protected void onBoundsChange(Rect r){}boolean getPadding(Rect r){return true;}void getOutline(Outline o){}void draw(Canvas c){}void setAlpha(int alpha){}void setColorFilter(ColorFilter f){}int getOpacity(){return 1;}void invalidateSelf(){} }
 static class GradientDrawable extends Drawable {static int boundsUpdates;enum Orientation{TOP_BOTTOM}float radius;int stroke,color;GradientDrawable(Orientation o,int[] colors){color=colors[0];}void setCornerRadius(float r){radius=r;}void setStroke(int s,int c){stroke=s;}@Override void setBounds(Rect r){if(bounds.left!=r.left||bounds.top!=r.top||bounds.right!=r.right||bounds.bottom!=r.bottom)boundsUpdates++;super.setBounds(r);}@Override void getOutline(Outline o){o.setAlpha(1);o.setRoundRect(bounds,radius);} }
 static class Metrics {float density=2.625f;}
 static class Resources{Metrics getDisplayMetrics(){return new Metrics();} }
 static class OvershootInterpolator{}
 static class KeyboardHaptics {static boolean enabled(Object c){return true;}}
 static class View {Object getContext(){return null;}void setHapticFeedbackEnabled(boolean b){}Map<Integer,Object> tags=new HashMap<>();KeyboardKeycaps.Cap bg;Object getBackground(){return bg;}float elevation,x=1,y=1;int duration,pad;Resources getResources(){return new Resources();}void setTag(int id,Object value){tags.put(id,value);}void setBackground(KeyboardKeycaps.Cap cap){bg=cap;}void setPadding(int l,int t,int r,int b){pad=l+t+r+b;}void setElevation(float e){elevation=e;}Animator animate(){return new Animator(this);} }
 static class Animator {View v;Animator(View v){this.v=v;}void cancel(){}Animator scaleX(float x){v.x=x;return this;}Animator scaleY(float y){v.y=y;return this;}Animator setDuration(int ms){v.duration=ms;return this;}Animator translationX(int n){return this;}Animator translationY(int n){return this;}Animator rotationX(int n){return this;}Animator rotationY(int n){return this;}Animator setInterpolator(OvershootInterpolator o){return this;}void start(){} }
 /* FACTORY */
 @Test public void r3b_factoryMarkersDimensionsAndZeroBorder(){for(boolean dark:new boolean[]{true,false})for(String role:List.of("left","right","zero","tools","core")){View v=new View();KeyboardKeycaps.apply(v,dark,role,0);assertEquals("keyboard-keycap-690",v.tags.get(3));assertEquals(role,v.tags.get(1));assertEquals(Math.round(5*2.625f),v.bg.shape.radius,0);assertEquals(Math.round(1.5f*2.625f),v.elevation,0);assertEquals("zero".equals(role)?Math.round(2.625f):0,v.bg.shape.stroke);assertEquals(0,v.pad);}}
 @Test public void a2_6_insetAndHighlightMatchRoundedBaselineNoTextPadding(){for(float inset:new float[]{0,1}){KeyboardKeycaps.Cap cap=KeyboardKeycaps.create(true,"left",2.625f,inset);cap.setBounds(0,0,200,150);Canvas c=new Canvas();int updates=GradientDrawable.boundsUpdates;cap.draw(c);assertEquals("draw must not mutate drawable bounds",updates,GradientDrawable.boundsUpdates);int i=Math.round(inset*2.625f),edge=Math.round(5*2.625f),line=Math.round(.5f*2.625f);assertEquals(1,c.lines.size());assertArrayEquals(new float[]{i+edge,i+line,200-i-edge,i+line,line},c.lines.get(0),0);assertEquals(Integer.valueOf(0x40FFFFFF),c.colors.get(0));assertEquals(0,cap.getBounds().left);Rect padding=new Rect();assertFalse(cap.getPadding(padding));assertEquals(0,padding.left);Outline o=new Outline();cap.getOutline(o);assertEquals(i,o.rect.left);assertEquals(200-i,o.rect.right);assertEquals("opaque baseline outline alpha",1,o.alpha,0);}}
 @Test public void r8d_factoryReapplyReadbackCoversSelfDrawnKeys(){View v=new View();int before=KeyboardKeycaps.reapplyCount();KeyboardKeycaps.apply(v,true,"left",0);assertEquals(before,KeyboardKeycaps.reapplyCount());KeyboardKeycaps.apply(v,true,"left",0);assertEquals(before+1,KeyboardKeycaps.reapplyCount());}
 @Test public void r3c_pressPointAndSpringDuration(){View v=new View();KeyboardKeycaps.press(v);assertEquals(.96f,v.x,0);assertEquals(.96f,v.y,0);KeyboardKeycaps.release(v);assertEquals(1,v.x,0);assertEquals(190,v.duration);}
}
