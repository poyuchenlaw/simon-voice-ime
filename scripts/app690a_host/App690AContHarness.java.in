 static class PopupWindow{static int created;final View content;final int width,height;int x,y,shows,updates,dismisses;boolean showing,focusable,touchable=true,screen;PopupWindow(View c,int w,int h,boolean f){content=c;width=w;height=h;focusable=f;created++;}void setBackgroundDrawable(ColorDrawable d){}void setClippingEnabled(boolean b){}void setTouchable(boolean b){touchable=b;}void setFocusable(boolean b){focusable=b;}boolean isTouchable(){return touchable;}boolean isFocusable(){return focusable;}void setElevation(int e){}View getContentView(){return content;}void setIsLaidOutInScreen(boolean b){screen=b;}boolean isShowing(){return showing;}boolean failShow;void showAtLocation(View v,int g,int a,int b){if(failShow)throw new RuntimeException("hidden");x=a+(screen?0:0);y=b+(screen?0:1254);shows++;showing=true;}void update(int a,int b,int w,int h){x=a;y=b;updates++;}void dismiss(){showing=false;dismisses++;}}
 static class KeyboardKeycaps{static void release(View v){}}
 static class State{void cancelTouches(){}}
 static class Hooks{int anchors,closes;void cursorAnchor(Object i){anchors++;}void cancel(Object k,boolean clear){}void close(Object k){closes++;}}
 static class Touch{DualHandStateStroke stroke;DualHandGesture.Result result;String feedback="tap";Runnable repeat;int repeats;boolean repeated;float lastX=500,lastY=900;}
 static class DualHandStateStroke{String key;long down=1000;DualHandStateStroke(String k){key=k;}}
 final Service service=new Service();final Handler ui=new Handler();final MessageQueue queue=new MessageQueue();final Map<String,FrameLayout> keys=new LinkedHashMap<>();final Map<Integer,Touch> touches=new HashMap<>();final State state=new State();final Hooks hooks=new Hooks();final Runnable flush=()->{};
 final Surface root=new Surface();final View topBar=new View();PopupWindow bubble;TextView bubbleLabel;boolean closed,split;float labelSizeSp=13.5f,rowDp=78;int safeInset=84;String failedSplitKey="";DualHandTable table;
 /* FIELDS */
 public App690AContHarness()throws Exception{Looper.queue=queue;PopupWindow.created=0;Path p=Path.of("app/src/phone/assets/dual_hand");table=new DualHandTable(Files.newBufferedReader(p.resolve("dual_hand_map.tsv")),Files.newBufferedReader(p.resolve("left_hand.tsv")),Files.newBufferedReader(p.resolve("draft_chars.tsv")));keys.put("Ø",new FrameLayout(service));}
 TextView text(String s,float f){TextView t=new TextView();t.setText(s);t.setTextSize(f);return t;}int color(String role){return DualHandVisuals.color(false,role);}String labelState(){return null;}void haptic(int kind){}void function(String key,String direction){}
 /* METHODS */
 final class Surface extends LinearLayout{Surface(){super(null);}/* SURFACE */}
 static class KeyboardInsets{/* PARENT_OWNED */static int bottom(android.view.WindowInsets in){return in==null?0:in.getInsets(1).bottom;}}
 static class KeyboardInputLayout extends View{int baselineBottom=-1,lastInset=-1;/* PARENT_INSET */}
 boolean desired(int orientation,int height,int inset){service.resources.config.orientation=orientation;service.resources.config.screenHeightDp=height;safeInset=inset;android.util.DisplayMetrics metrics=service.getResources().getDisplayMetrics();String layoutKey="fixture";/* PREDICATE */return desired;}
 int contentHeight(){/* TOP *//* ROW */return topBar.height+3*dp(rowDp);}
 void palettePadding(){/* PADDING */}
 void layout(){root.onLayout(true,0,0,1050,944);}
 void warm(){layout();queue.idle();assertNotNull("idle after layout must create popup before first gesture",bubble);}
 void draw(){bubble.getContentView().getViewTreeObserver().draw();ui.drain();}
 Touch touch(String direction){Touch t=new Touch();t.stroke=new DualHandStateStroke("Ø");t.result=DualHandGesture.classify("Ø",false,"right".equals(direction)?28:0,0,40,28,6);return t;}
 @Test public void prewarmOnlyAfterLayoutIdleAndRetainsHaloTwoDraws(){layout();assertNull("layout does not create a window synchronously",bubble);queue.idle();assertNotNull("missing idle prewarm",bubble);assertEquals("ㄨ",bubbleLabel.value);assertEquals(labelSizeSp*1.25f,bubbleLabel.size,0);FrameLayout c=(FrameLayout)bubble.getContentView();assertTrue(c.children.get(0).halo);assertNotNull("halo render effect retained",c.children.get(0).effect);assertFalse(bubble.isTouchable());assertFalse(bubble.isFocusable());assertTrue("fully offscreen including elevation",bubble.x+bubble.width+dp(3)<0);assertEquals(1,c.observer.listeners.size());draw();assertTrue(bubble.isShowing());assertEquals(1,c.observer.listeners.size());assertEquals(1,c.invalidations);draw();assertTrue("must remain attached after second actual draw",bubble.isShowing());assertEquals(0,c.observer.listeners.size());layout();queue.idle();assertEquals(1,bubble.shows);}
 @Test public void firstDownKeepsParkedWindowThenSwipeUpdatesAndReleaseDismisses(){warm();draw();draw();feedback(touch("tap"));assertTrue("first down must not dismiss warm window",bubble.isShowing());feedback(touch("right"));assertEquals("ㄨ",bubbleLabel.value);assertEquals(1,bubble.shows);assertEquals(1,bubble.updates);assertTrue(bubble.x>=0);releaseCap("Ø");assertFalse(bubble.isShowing());feedback(touch("right"));assertEquals(2,bubble.shows);releaseCap("Ø");layout();queue.idle();assertFalse("no recurrent prewarming after first use",bubble.isShowing());}
 @Test public void swipeBeforeIdleIsImmediateAndPreventsWarmup(){layout();feedback(touch("right"));assertNotNull(bubble);assertTrue(bubble.isShowing());assertEquals(1,bubble.shows);queue.idle();assertEquals(1,bubble.shows);assertEquals(0,bubble.getContentView().observer.listeners.size());}
 @Test public void swipeDuringFirstDrawDoesNotLetQueuedWarmupRehideRealFeedback(){warm();bubble.getContentView().observer.draw();feedback(touch("right"));ui.drain();assertEquals(1,bubble.shows);assertEquals(1,bubble.updates);assertTrue(bubble.isShowing());assertTrue(bubble.x>=0);assertEquals(0,bubble.getContentView().observer.listeners.size());}
 @Test public void finishInputViewCursorClearDismissesAndCancelsPendingDraw(){warm();bubble.getContentView().observer.draw();cursorAnchor(null);ui.drain();assertFalse(bubble.isShowing());assertEquals(0,bubble.getContentView().observer.listeners.size());assertEquals(1,hooks.anchors);queue.idle();assertFalse(bubble.isShowing());}
 @Test public void windowHiddenDismissesAndCancelsIdle(){layout();root.windowVisibility=View.GONE;root.onWindowVisibilityChanged(View.GONE);queue.idle();assertNull(bubble);root.windowVisibility=View.VISIBLE;root.onWindowVisibilityChanged(View.VISIBLE);queue.idle();assertNotNull(bubble);root.windowVisibility=View.GONE;root.onWindowVisibilityChanged(View.GONE);assertFalse(bubble.isShowing());assertEquals(0,bubble.getContentView().observer.listeners.size());}
 @Test public void pageSwitchAndDetachDismissWithoutResurrection(){warm();bubble.getContentView().observer.draw();root.shown=false;root.onVisibilityChanged(root,View.GONE);ui.drain();assertFalse(bubble.isShowing());root.shown=true;root.onVisibilityChanged(root,View.VISIBLE);queue.idle();assertTrue(bubble.isShowing());root.attached=false;root.onDetachedFromWindow();ui.drain();assertFalse(bubble.isShowing());assertEquals(0,bubble.getContentView().observer.listeners.size());}
 @Test public void destroyWithNoKeysStillDismissesAndRemovesIdle(){layout();keys.clear();close();queue.idle();assertNull(bubble);assertEquals(1,hooks.closes);closed=false;keys.put("Ø",new FrameLayout(service));warm();keys.clear();close();assertFalse(bubble.isShowing());assertEquals(0,bubble.getContentView().observer.listeners.size());}
 @Test public void noWarmupWhenNotShownNotLaidOutDetachedOrTouchActive(){root.shown=false;layout();queue.idle();assertNull(bubble);root.shown=true;root.width=0;layout();queue.idle();assertNull(bubble);root.width=1050;root.attached=false;layout();queue.idle();assertNull(bubble);root.attached=true;layout();touches.put(0,touch("tap"));queue.idle();assertNull("idle must not interrupt user's first touch",bubble);}
 @Test public void hiddenWindowWithVisibleViewTreeNeverPrewarms(){root.windowVisibility=View.GONE;layout();queue.idle();assertNull("isShown only tests ancestor visibility, not window visibility",bubble);}
 @Test public void legacyApiStillParksOutsideScreenAndCleansUp(){Build.VERSION.SDK_INT=28;try{warm();assertTrue(bubble.x+bubble.width+dp(3)<0);cursorAnchor(null);assertFalse(bubble.isShowing());}finally{Build.VERSION.SDK_INT=34;}}
 @Test public void landscapeUsesContentBudgetNotGesturePadding(){assertTrue("182dp content <=193.6dp; inset already excluded from available screen",desired(2,352,84));split=true;assertEquals(477,contentHeight());KeyboardInputLayout parent=new KeyboardInputLayout();parent.applyInsets(new android.view.WindowInsets());root.parent=parent;palettePadding();assertEquals(0,root.paddingBottom);assertEquals(84,parent.paddingBottom);assertEquals("182dp rows +32dp safety =214dp",561,contentHeight()+parent.paddingBottom);assertTrue("bottom row including safety fits F visible 861px",contentHeight()+parent.paddingBottom<=861);assertTrue(desired(2,352,0));}
 @Test public void portraitAndSmallHeightPreferenceGuardsStayUnchanged(){assertFalse(desired(1,856,84));split=false;assertEquals(936,dp(44)+4*dp(78));root.parent=null;palettePadding();assertEquals(92,root.paddingBottom);assertFalse("182dp exceeds330*.55",desired(2,330,0));assertTrue(desired(2,331,84));service.prefs.enabled=false;assertFalse(desired(2,352,84));service.prefs.enabled=true;failedSplitKey="fixture";assertFalse(desired(2,352,84));}
