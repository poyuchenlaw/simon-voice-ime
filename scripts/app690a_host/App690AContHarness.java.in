 static class Service{final Resources resources=new Resources();final Prefs prefs=new Prefs();Resources getResources(){return resources;}Prefs getSharedPreferences(String n,int mode){return prefs;}}
 static class Handler{final List<Runnable> jobs=new ArrayList<>();void post(Runnable r){jobs.add(r);}void postDelayed(Runnable r,long delay){jobs.add(r);}void removeCallbacks(Runnable r){jobs.remove(r);}void drain(){int guard=0;while(!jobs.isEmpty()){assertTrue(++guard<50);jobs.remove(0).run();}}}
 static class MessageQueue{interface IdleHandler{boolean queueIdle();}final List<IdleHandler> handlers=new ArrayList<>();void addIdleHandler(IdleHandler h){handlers.add(h);}void removeIdleHandler(IdleHandler h){handlers.remove(h);}void idle(){for(IdleHandler h:new ArrayList<>(handlers))if(!h.queueIdle())handlers.remove(h);}}
 static class Looper{static MessageQueue queue;static MessageQueue myQueue(){return queue;}}
 static class ViewTreeObserver{interface OnDrawListener{void onDraw();}final List<OnDrawListener> listeners=new ArrayList<>();boolean alive=true;boolean isAlive(){return alive;}void addOnDrawListener(OnDrawListener l){listeners.add(l);}void removeOnDrawListener(OnDrawListener l){listeners.remove(l);}void draw(){for(OnDrawListener l:new ArrayList<>(listeners))l.onDraw();}}
 static class Animator{Animator translationX(float f){return this;}Animator translationY(float f){return this;}Animator rotationX(float f){return this;}Animator rotationY(float f){return this;}Animator setDuration(long l){return this;}void start(){}}
 static class View{static final int VISIBLE=0,GONE=8;int width=1050,height=944,paddingBottom,invalidations,windowVisibility;boolean shown=true,attached=true,halo;Object effect;View parent;final ViewTreeObserver observer=new ViewTreeObserver();View(){}View(Object c){}boolean isShown(){return shown;}int getWindowVisibility(){return windowVisibility;}boolean isAttachedToWindow(){return attached;}int getWidth(){return width;}int getHeight(){return height;}Resources getResources(){return new Resources();}View getRootView(){View decor=new View();decor.height=2376;return decor;}void getLocationOnScreen(int[] a){a[0]=17;a[1]=1254;}void getLocationInWindow(int[] a){a[0]=17;a[1]=0;}ViewTreeObserver getViewTreeObserver(){return observer;}void invalidate(){invalidations++;}void setTag(int i,Object o){}void setBackground(GradientDrawable g){halo=true;}void setRenderEffect(Object e){effect=e;}void setPressed(boolean b){}boolean isHardwareAccelerated(){return true;}Animator animate(){return new Animator();}void setPadding(int l,int t,int r,int b){paddingBottom=b;}int getPaddingBottom(){return paddingBottom;}int getPaddingLeft(){return 0;}int getPaddingTop(){return 0;}int getPaddingRight(){return 0;}View getParent(){return parent;}void setLayoutParams(LinearLayout.LayoutParams p){height=p.height;}}
 static class TextView extends View{String value="";float size;void setText(String s){value=s;}void setTextSize(float f){size=f;}void setGravity(int g){}void setTextColor(int c){}}
