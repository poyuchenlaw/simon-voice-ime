    @Test public void lineGhostwriterFreshSnapshotDirtyBeforeDurableCommitNeverInserts() throws Exception {
        String id=session(1);voicePendingQueue.retainDirective(id);ghostwriterField=true;lineGenerations.add(1);lineDrafts.put(1,"");
        LineContextAccessibilityService.Snapshot same=new LineContextAccessibilityService.Snapshot("same chat");
        lineRequests.put(1,same);LineContextAccessibilityService.fresh=same;
        mainHandler.deferPosts=true;
        handleAiCommandResponse(new Response(200,"{\"text\":\"generated draft\",\"status\":\"ok\"}"),1,1);
        mainHandler.posts.remove(0).run();barrier();same.contentFresh=false;
        mainHandler.deferPosts=false;for(Runnable r:new ArrayList<>(mainHandler.posts)){mainHandler.posts.remove(r);r.run();}barrier();
        assertTrue(connection.inserted.isEmpty());assertTrue(clipboard.values.isEmpty());
        VoicePendingQueue restarted=new VoicePendingQueue(temp.getRoot(),16000);restarted.retryForUser(id);
        assertFalse(restarted.pendingOldestFirst().contains(id));assertTrue(restarted.pcmFile(id).exists());
    }
    /* SERVICE_METHODS */
    @Test public void queuedLongAudioUsesCustodyChildrenAndWholeParentClipboard()throws Exception {
        String id=voicePendingQueue.begin();byte[] pcm=new byte[(int)VoicePendingQueue.CHUNK_BYTES+8];voicePendingQueue.append(id,pcm,pcm.length);voicePendingQueue.markPending(id,"offline");
        JSONObject original=identity(id);httpClient.code=200;httpClient.raw="{\"text\":\"各段假校正不得交付\"}";
        httpClient.routes.put("http://fake/v1/audio-archive/transcribe",new Response(200,new JSONObject().put("text","完整句子").put("ai_corrected",true).put("receipt",original).toString()));
        drainPendingVoiceQueue();waitFor(()->!pendingDrainRunning.get());barrier();
        assertEquals(Arrays.asList("http://fake/v1/audio-archive","http://fake/v1/audio-archive","http://fake/v1/audio-archive/transcribe"),httpClient.requestUrls);
        for(int n=0;n<2;n++){MultipartBody child=(MultipartBody)httpClient.requestBodies.get(n);assertEquals("true",child.fields.get("custody_only"));}
        MultipartBody parent=(MultipartBody)httpClient.requestBodies.get(2);assertEquals(id,parent.fields.get("client_session_id"));assertEquals("3840008",parent.fields.get("parent_byte_count"));assertEquals(original.getString("sha256"),parent.fields.get("parent_sha256"));assertEquals(2,new org.json.JSONArray(parent.fields.get("child_receipts")).length());
        assertEquals(Arrays.asList("完整句子"),clipboard.values);assertEquals(Arrays.asList("完整句子"),clipboardHelper.history);assertTrue(connection.inserted.isEmpty());assertEquals(1,notifications);files(id,false);
    }
    @Test public void audioAuthExplicitlyNegotiatesPcmBeforeAnyAudio()throws Exception {
