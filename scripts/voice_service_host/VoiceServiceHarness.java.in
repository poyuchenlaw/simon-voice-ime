    @Test public void normalRecorderStreamHasSameReceiptWithoutArchive()throws Exception {
        String id=voicePendingQueue.beginAsync();voicePendingQueue.holdForReceipt(id);
        for(int i=0;i<8;i++){byte[] chunk=new byte[4096];Arrays.fill(chunk,(byte)(i+1));persistRecordingRead(id,chunk,chunk.length);streamCapturedRead(chunk,chunk.length);}
        voicePendingQueue.finishRecording(id);barrier();
        assertArrayEquals("stream must cover exactly the local backup",voicePendingQueue.pcmBytes(id),pcmBuffer.toByteArray());
        byte[] stream=pcmBuffer.toByteArray();StringBuilder sha=new StringBuilder();for(byte b:java.security.MessageDigest.getInstance("SHA-256").digest(stream))sha.append(String.format("%02x",b&255));
        receiveAudioReceipt(id,new JSONObject().put("client_session_id",id).put("byte_count",stream.length).put("sha256",sha.toString()));barrier();
        drainPendingVoiceQueue();waitFor(()->!pendingDrainRunning.get());files(id,false);assertEquals(0,httpClient.calls.get());
    }


