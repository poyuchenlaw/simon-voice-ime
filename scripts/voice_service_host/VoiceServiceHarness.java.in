    @Test public void lifecycleNeverWaitsIndefinitelyForDisk()throws Exception {
        session(1);
        CountDownLatch entered=new CountDownLatch(1),release=new CountDownLatch(1);
        voicePendingQueue.execute(()->{entered.countDown();try{release.await();}catch(InterruptedException e){Thread.currentThread().interrupt();}});
        assertTrue(entered.await(2,TimeUnit.SECONDS));ExecutorService caller=Executors.newSingleThreadExecutor();
        try {
            for(int callback=0;callback<4;callback++) {
                final int which=callback;long start=System.nanoTime();
                Future<?> f=caller.submit(()->{switch(which){case 0:onFinishInputView(false);break;case 1:onDestroy();break;case 2:onLowMemory();break;default:onTrimMemory(80);}});
                try {f.get(180,TimeUnit.MILLISECONDS);}catch(TimeoutException e){fail("lifecycle callback "+which+" blocked on disk");}
                assertTrue("callback exceeds bounded wait",(System.nanoTime()-start)/1_000_000<180);
            }
        }finally{release.countDown();caller.shutdownNow();barrier();}
    }
