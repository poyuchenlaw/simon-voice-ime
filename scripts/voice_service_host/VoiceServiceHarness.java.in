    static class BufferedSink {final ByteArrayOutputStream bytes=new ByteArrayOutputStream();CountDownLatch entered,release;int writesBeforeStall,writes;void stall()throws IOException{if(writes++<writesBeforeStall)return;if(entered!=null){entered.countDown();try{release.await();}catch(InterruptedException e){throw new IOException(e);}}}void write(byte[] b)throws IOException{stall();bytes.write(b);}void write(byte[] b,int off,int n)throws IOException{stall();bytes.write(b,off,n);}}
    static class RequestBody {byte[] data=new byte[0];MediaType contentType(){return MediaType.parse("audio/wav");}long contentLength(){return data.length;}void writeTo(BufferedSink sink)throws IOException{sink.write(data);}static RequestBody create(byte[] b,MediaType m){RequestBody r=new RequestBody();r.data=b;return r;}}
    static class MediaType {static MediaType parse(String s){return new MediaType();}}
    static class MultipartBody extends RequestBody {static final String FORM="form";final List<RequestBody> files=new ArrayList<>();final Map<String,String> fields=new HashMap<>();static class Builder {final MultipartBody body=new MultipartBody();Builder setType(String s){return this;}Builder addFormDataPart(String k,String v){body.fields.put(k,v);return this;}Builder addFormDataPart(String k,String f,RequestBody r){body.files.add(r);return this;}MultipartBody build(){return body;}}}
    static class Request {RequestBody body;String url,method="GET",auth;static class Builder {final Request request=new Request();Builder url(String s){request.url=s;return this;}Builder post(RequestBody b){request.body=b;request.method="POST";return this;}Builder delete(){request.method="DELETE";return this;}Builder addHeader(String k,String v){if(k.equals("Authorization"))request.auth=v;return this;}Request build(){return request;}}}
    interface Callback {void onFailure(Call c,IOException e);void onResponse(Call c,Response r)throws IOException;}
    static class Response implements AutoCloseable {int code;String raw;Response(int c,String s){code=c;raw=s;}boolean isSuccessful(){return code>=200&&code<300;}int code(){return code;}Body body(){return new Body(raw);}public void close(){}}
    static class Body {String raw;Body(String r){raw=r;}String string(){return raw;}}
    static class Call {
        final FakeHttp http;final Request request;Call(FakeHttp h){this(h,null);}Call(FakeHttp h,Request r){http=h;request=r;}
        Response execute()throws IOException {if(request!=null){http.requestUrls.add(request.url);http.requestTimes.add(System.nanoTime());}http.calls.incrementAndGet();if(http.entered!=null)http.entered.countDown();if(http.release!=null)try{http.release.await();}catch(InterruptedException e){throw new IOException(e);}String raw=http.raw;if(request!=null&&request.method.equals("DELETE")&&http.code==200)raw="{\"discarded\":true}";
            if(http.code==200&&request!=null&&request.url.endsWith("/v1/audio-archive"))try {
                MultipartBody body=(MultipartBody)request.body;BufferedSink sink=new BufferedSink();body.files.get(0).writeTo(sink);
                byte[] wav=sink.bytes.toByteArray(),pcm=Arrays.copyOfRange(wav,44,wav.length);
                byte[] digest=java.security.MessageDigest.getInstance("SHA-256").digest(pcm);StringBuilder sha=new StringBuilder();for(byte b:digest)sha.append(String.format("%02x",b&255));
                raw=new JSONObject(raw).put("receipt",new JSONObject().put("client_session_id",body.fields.get("client_session_id")).put("byte_count",pcm.length).put("sha256",sha.toString())).toString();
            }catch(Exception e){throw new IOException(e);}
            return request!=null&&http.routes.containsKey(request.url)?http.routes.get(request.url):new Response(http.code,raw);}
        void enqueue(Callback cb){http.callbacks.add(cb);}
    }
    static class OkHttpClient extends FakeHttp {}
    static class FakeHttp {Map<String,Response> routes=new ConcurrentHashMap<>();List<String> requestUrls=new CopyOnWriteArrayList<>();List<String> requestMethods=new CopyOnWriteArrayList<>(),requestAuths=new CopyOnWriteArrayList<>();List<Long> requestTimes=new CopyOnWriteArrayList<>();List<RequestBody> requestBodies=new CopyOnWriteArrayList<>();RequestBody lastBody;String lastMethod,lastAuth;AtomicInteger calls=new AtomicInteger();int code=503;String raw="{\"text\":\"queued words\"}";CountDownLatch entered,release;List<Callback> callbacks=new ArrayList<>();Builder newBuilder(){return new Builder(this);}Call newCall(Request r){requestBodies.add(r.body);lastBody=r.body;lastMethod=r.method;lastAuth=r.auth;requestMethods.add(r.method);requestAuths.add(r.auth==null?"":r.auth);return new Call(this,r);}}
    static class Builder {FakeHttp h;Builder(FakeHttp h){this.h=h;}Builder readTimeout(long t,TimeUnit u){return this;}Builder callTimeout(long t,TimeUnit u){return this;}OkHttpClient build(){OkHttpClient client=new OkHttpClient();client.requestBodies=h.requestBodies;client.requestUrls=h.requestUrls;client.requestMethods=h.requestMethods;client.requestAuths=h.requestAuths;client.requestTimes=h.requestTimes;client.calls=h.calls;client.routes=h.routes;client.code=h.code;client.raw=h.raw;client.entered=h.entered;client.release=h.release;client.callbacks=h.callbacks;return client;}}
