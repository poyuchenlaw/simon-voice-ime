    @Test public void recordingTailPersistsUntilMatchingFullReceipt()throws Exception {
        String id=voicePendingQueue.beginAsync();pendingSessionByGeneration.put(1,id);activePendingSessionId=id;isRecording=true;voicePendingQueue.appendAsync(id,new byte[]{1,2},2);AudioRecord recorder=new AudioRecord();Thread t=new Thread(()->readAndPersistRecordingAudio(recorder,new byte[8],id));t.start();assertTrue(recorder.entered.await(3,TimeUnit.SECONDS));isRecording=false;voicePendingQueue.acknowledgeDelivery(id,false);recorder.release.countDown();t.join();voicePendingQueue.finishRecording(id);barrier();files(id,true);assertArrayEquals(new byte[]{1,2,5,6},voicePendingQueue.pcmBytes(id));receiveAudioReceipt(id,identity(id));barrier();files(id,false);
    }
    @Test public void protectedSwitchDuringRecordingDiscardsFinalReadAndLateResults()throws Exception {
        String id=voicePendingQueue.beginAsync();pendingSessionByGeneration.put(1,id);activePendingSessionId=id;isRecording=true;
        AudioRecord recorder=new AudioRecord();ExecutorService worker=Executors.newSingleThreadExecutor();Future<?> read=worker.submit(()->readAndPersistRecordingAudio(recorder,new byte[4],id));
        assertTrue(recorder.entered.await(3,TimeUnit.SECONDS));protectedInputField=true;discardProtectedRecording();isRecording=false;activePendingSessionId=null;
        recorder.release.countDown();read.get(3,TimeUnit.SECONDS);finishDurableRecording(id);
        handleAiCommandResponse(new Response(200,"{\"text\":\"late words\"}"),1,1);barrier();files(id,false);assertTrue(clipboard.values.isEmpty());assertTrue(connection.inserted.isEmpty());worker.shutdown();
    }
    @Test public void startAndAppendDoNotWaitForDiskExecutor()throws Exception {
        CountDownLatch blocked=new CountDownLatch(1),release=new CountDownLatch(1);
        voicePendingQueue.execute(()->{blocked.countDown();try{release.await();}catch(InterruptedException e){throw new IllegalStateException(e);}});
        assertTrue(blocked.await(3,TimeUnit.SECONDS));ExecutorService ui=Executors.newSingleThreadExecutor();
        Future<String> started=ui.submit(()->{String id=voicePendingQueue.beginAsync();persistRecordingRead(id,new byte[]{7,8},2);return id;});
        String id;
        try{id=started.get(2,TimeUnit.SECONDS);}finally{release.countDown();ui.shutdown();}
        pendingSessionByGeneration.put(1,id);assertArrayEquals(new byte[]{7,8},voicePendingQueue.pcmBytes(id));finishDurableRecording(id);barrier();files(id,true);
    }

    @Test public void httpFallbackReadsWholeDurableAudioBeyondTenMinutes()throws Exception {
        String id=voicePendingQueue.begin();pendingSessionByGeneration.put(1,id);byte[] megabyte=new byte[1024*1024];
        for(int i=0;i<19;i++)voicePendingQueue.append(id,megabyte,megabyte.length);voicePendingQueue.append(id,new byte[]{9,10},2);voicePendingQueue.markPending(id,"");
        sendFullAudioHttpFallback(1,new byte[44],new byte[2]);RequestBody file=((MultipartBody)httpClient.lastBody).files.get(0);
        ExecutorService network=Executors.newSingleThreadExecutor();BufferedSink sink=new BufferedSink();
        long length=network.submit(()->{long n=file.contentLength();file.writeTo(sink);return n;}).get(5,TimeUnit.SECONDS);network.shutdown();
        assertEquals(19L*1024*1024+2+44,length);byte[] sent=sink.bytes.toByteArray();assertEquals(length,sent.length);assertEquals(9,sent[sent.length-2]);assertEquals(10,sent[sent.length-1]);
        httpClient.callbacks.get(0).onResponse(new Call(httpClient),new Response(200,"{\"text\":\"whole recording\"}"));barrier();files(id,true);
    }
