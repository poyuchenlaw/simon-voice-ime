    @Test public void spellTranslateErrorAndParseFailureRetryThroughOnResponse()throws Exception {
        for(Mode mode:new Mode[]{Mode.SPELL,Mode.TRANSLATE})for(Response response:new Response[]{new Response(503,"failed"),new Response(200,"not-json")}) {
            int gen=mode.ordinal()*10+httpClient.callbacks.size()+1;String id=session(gen);
            sendToWTI(new byte[44],mode,false,gen);httpClient.callbacks.get(httpClient.callbacks.size()-1).onResponse(new Call(httpClient),response);
            barrier();assertFalse("terminal onResponse must release the pending generation for retry",pendingSessionByGeneration.containsKey(gen));waitFor(()->!pendingDrainRunning.get());files(id,true);
            waitFor(()->pendingDrainTask!=null&&!pendingDrainTask.isCancelled());
        }
    }
