    @Before public void init(){voicePendingQueue=new VoicePendingQueue(temp.getRoot(),16000);}
    String session(int gen)throws Exception {String id=voicePendingQueue.begin();voicePendingQueue.append(id,new byte[32000],32000);fullPcmByGeneration.put(gen,new byte[32000]);voicePendingQueue.markPending(id,"test");pendingSessionByGeneration.put(gen,id);return id;}
    void barrier()throws Exception { // A synchronous PCM read on a sentinel waits behind all service writes.
        voicePendingQueue.runIO(()->null);voicePendingQueue.runIO(()->null);
    }
    void files(String id,boolean present){assertEquals(present,new File(temp.getRoot(),"voice_pending/"+id+".pcm").exists());if(present)assertTrue(new File(temp.getRoot(),"voice_pending/"+id+".json").exists());}
    void waitFor(java.util.function.BooleanSupplier predicate)throws Exception {long end=System.nanoTime()+TimeUnit.SECONDS.toNanos(30);while(!predicate.getAsBoolean()&&System.nanoTime()<end)Thread.sleep(2);assertTrue("callback did not finish",predicate.getAsBoolean());}
    @After public void settle()throws Exception {
        barrier();for(CountDownLatch waiter:audioReceiptWaiters.values())waiter.countDown();
        if(pendingDrainTask!=null)pendingDrainTask.cancel(false);pendingVoiceExecutor.shutdown();
        assertTrue("uploader stopped",pendingVoiceExecutor.awaitTermination(5,TimeUnit.SECONDS));
        waitFor(()->Thread.getAllStackTraces().keySet().stream().noneMatch(t->(t.getName().equals("VoicePendingUploader")||t.getName().equals("VoiceAudioReceipt"))&&t.isAlive()));barrier();
    }
    File filesDirOverride;File getFilesDir(){return filesDirOverride==null?temp.getRoot():filesDirOverride;}
    static class AudioRecord {
        static final int ERROR_INVALID_OPERATION=-3;
        byte[] next={5,6};CountDownLatch entered=new CountDownLatch(1),release=new CountDownLatch(1);
        int read(byte[] b,int off,int len) {entered.countDown();try{release.await();}catch(InterruptedException e){throw new IllegalStateException(e);}System.arraycopy(next,0,b,off,next.length);return next.length;}
    }
