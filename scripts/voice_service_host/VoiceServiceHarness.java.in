    @Test public void conflictWithKnownBadLocalFileAcceptsLongEnoughServerCustody()throws Exception {
        for(boolean hadLiveText:new boolean[]{true,false}) {
        String id=session(utteranceGeneration.incrementAndGet());pendingSessionByGeneration.clear();
        File meta=new File(temp.getRoot(),"voice_pending/"+id+".json");JSONObject m=new JSONObject(new String(java.nio.file.Files.readAllBytes(meta.toPath()),java.nio.charset.StandardCharsets.UTF_8));
        m.put("local_write_failed",true).put("streamed_bytes",8).put("streamed_bytes_final",true);
        if(hadLiveText)m.put("result_text","delivered words").put("delivered",true);
        java.nio.file.Files.write(meta.toPath(),m.toString().getBytes(java.nio.charset.StandardCharsets.UTF_8));voicePendingQueue=new VoicePendingQueue(temp.getRoot(),16000);
        httpClient.code=409;JSONObject receipt=new JSONObject().put("client_session_id",id).put("byte_count",8).put("sha256","aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
        httpClient.routes.put("http://fake/v1/audio-receipt?client_session_id="+id,new Response(200,receipt.toString()));
        if(hadLiveText)httpClient.routes.put("http://fake/v1/audio-archive/transcribe",new Response(200,new JSONObject().put("text","delivered words").put("receipt",receipt).toString()));
        else httpClient.routes.remove("http://fake/v1/audio-archive/transcribe");
        drainPendingVoiceQueue();waitFor(()->!pendingDrainRunning.get());barrier();
        assertFalse("known-bad local PCM can leave only after sufficient server custody",voicePendingQueue.pcmFile(id).exists());
        assertTrue(voicePendingQueue.receiptConfirmed(id));assertTrue(connection.inserted.isEmpty());assertTrue(clipboard.values.isEmpty());
        assertFalse("custody-only recovery must not claim microphone silence",status.contains("沒有錄到聲音"));
        }
    }
