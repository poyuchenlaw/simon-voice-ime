        identity(id);voicePendingQueue=new VoicePendingQueue(temp.getRoot(),16000);
        assertTrue("persisted failure survives actual queue reload",voicePendingQueue.backupFailed(id));
        voicePendingQueue.holdForReceipt(id);wsFinal(new JSONObject().put("text",""),1);barrier();
        assertFalse(voicePendingQueue.delivered(id));assertFalse(deliveredVoiceGenerations.contains(1));files(id,true);
    }
    @Test public void wsDelayedSilenceProofCannotDeliverNewGenerationOrDuplicateText()throws Exception {
        String id=session(1);voicePendingQueue.holdForReceipt(id);armVoiceFinalDeadline(1);
        mainHandler.deferPosts=true;wsFinal(new JSONObject().put("text",""),1);
        Runnable finalCallback=mainHandler.posts.remove(0);finalCallback.run();barrier();
        String next=session(2);voicePendingQueue.holdForReceipt(next);utteranceGeneration.set(2);activeUtteranceGeneration=2;
        mainHandler.deferPosts=false;for(Runnable r:new ArrayList<>(mainHandler.posts)){mainHandler.posts.remove(r);r.run();}barrier();
        consumeSilentResult(1,"");recoverUnfinishedVoiceGeneration(1,"duplicate_close");barrier();
        assertTrue(voicePendingQueue.delivered(id));assertFalse(voicePendingQueue.delivered(next));assertFalse(deliveredVoiceGenerations.contains(2));
        assertTrue(clipboard.values.isEmpty());assertTrue(clipboardHelper.history.isEmpty());assertTrue(connection.inserted.isEmpty());
        files(id,true);files(next,true);
    }
    @Test public void quietAudibleAcceptedFinalMustCancelExistingDeadline()throws Exception {
        String id=session(1);voicePendingQueue.holdForReceipt(id);armVoiceFinalDeadline(1);
        audibleVoiceGenerations.add(1);acceptedTextLengths.put(1,12);
        wsFinal(new JSONObject().put("text",""),1);barrier();
        assertFalse("non-proof audible-empty branch must preserve old immediate cancellation",voiceFinalDeadlines.containsKey(1));
    }
    @Test public void actualDeadlineBeforeProofClosesOnlyOneSlotAndPreservesAudio()throws Exception {
        String id=session(1);voicePendingQueue.holdForReceipt(id);String next=session(2);voicePendingQueue.holdForReceipt(next);
        armVoiceFinalDeadline(1);mainHandler.deferPosts=true;wsFinal(new JSONObject().put("text",""),1);Runnable finalCallback=mainHandler.posts.remove(0);
        CountDownLatch entered=new CountDownLatch(1),release=new CountDownLatch(1);
        voicePendingQueue.execute(()->{entered.countDown();try{release.await(5,TimeUnit.SECONDS);}catch(InterruptedException e){Thread.currentThread().interrupt();}});
        Thread deadlineThread=null;
        try {assertTrue(entered.await(3,TimeUnit.SECONDS));finalCallback.run();Runnable deadline=voiceFinalDeadlines.get(1);assertNotNull(deadline);
            deadlineThread=new Thread(deadline);deadlineThread.start();waitFor(()->recoverySessionByGeneration.containsKey(1));
            utteranceGeneration.set(2);activeUtteranceGeneration=2;
        }finally {release.countDown();barrier();if(deadlineThread!=null){deadlineThread.join(3000);assertFalse(deadlineThread.isAlive());}
            mainHandler.deferPosts=false;for(Runnable r:new ArrayList<>(mainHandler.posts)){mainHandler.posts.remove(r);r.run();}barrier();}
        assertEquals("net one ordering slot closed",2,nextGenToCommit);assertFalse(completedGenerations.contains(2));assertFalse(deliveredVoiceGenerations.contains(2));
        assertFalse(voicePendingQueue.delivered(next));assertTrue(clipboard.values.isEmpty());assertTrue(clipboardHelper.history.isEmpty());assertTrue(connection.inserted.isEmpty());files(id,true);files(next,true);
        JSONObject m=new JSONObject(new String(java.nio.file.Files.readAllBytes(new File(temp.getRoot(),"voice_pending/"+id+".json").toPath()),java.nio.charset.StandardCharsets.UTF_8));
        assertFalse(m.getBoolean("clipboard_written"));assertFalse(m.has("result_text"));assertFalse(voiceFinalDeadlines.containsKey(1));
    }
    @Test public void publicFailureAndReloadPositivelyRecoverAndCancelDeadline()throws Exception {
        for(boolean reload:new boolean[]{false,true}) {
            int gen=reload?2:1;String id=session(gen);voicePendingQueue.holdForReceipt(id);armVoiceFinalDeadline(gen);
            try{voicePendingQueue.append(id,new byte[]{1},2);fail("fault must throw");}catch(Exception expected){}
            identity(id);if(reload)voicePendingQueue=new VoicePendingQueue(temp.getRoot(),16000);
            assertTrue(voicePendingQueue.backupFailed(id));voicePendingQueue.holdForReceipt(id);
            wsFinal(new JSONObject().put("text",""),gen);barrier();
            assertTrue(recoverySessionByGeneration.containsKey(gen));assertFalse(voiceFinalDeadlines.containsKey(gen));assertFalse(voicePendingQueue.delivered(id));files(id,true);
        }
    }
    @Test public void leakedForegroundResumesRealPendingUploadAfterIdleLimit()throws Exception {
        String old=session(1);pendingSessionByGeneration.clear();voicePendingQueue.markPending(old,"fixture");
        pendingSessionByGeneration.put(2,"phantom");isRecording=true;recordingFinalizing=true;lastForegroundAudioMs=2000;
        drainPendingVoiceQueue();waitFor(()->!pendingDrainRunning.get());assertEquals(0,httpClient.calls.get());files(old,true);
        SystemClock.elapsed=122001;httpClient.code=200;
        drainPendingVoiceQueue();waitFor(()->!pendingDrainRunning.get());barrier();
        assertEquals(1,httpClient.calls.get());assertEquals(Arrays.asList("queued words"),clipboardHelper.history);
    }
    @Test public void normalGenerationCompletionImmediatelyWakesPendingUpload()throws Exception {
        String old=session(1);httpClient.code=200;
        assertTrue(foregroundVoiceBusy());
        markPendingGeneration(1,"normal_finish");barrier();waitFor(()->httpClient.calls.get()>0);waitFor(()->!pendingDrainRunning.get());barrier();
        assertEquals(2000,SystemClock.elapsed);assertEquals(1,httpClient.calls.get());assertFalse(pendingSessionByGeneration.containsKey(1));
    }
}
