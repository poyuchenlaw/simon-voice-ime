            File meta=new File(temp.getRoot(),"voice_pending/"+id+".json");JSONObject m=new JSONObject(new String(java.nio.file.Files.readAllBytes(meta.toPath()),java.nio.charset.StandardCharsets.UTF_8));
            m.put("local_write_failed",!invalid.equals("not-failed")).put("streamed_bytes",8).put("streamed_bytes_final",true);
            java.nio.file.Files.write(meta.toPath(),m.toString().getBytes(java.nio.charset.StandardCharsets.UTF_8));voicePendingQueue=new VoicePendingQueue(temp.getRoot(),16000);
            JSONObject receipt=new JSONObject().put("client_session_id",invalid.equals("wrong-id")?"other":id).put("byte_count",invalid.equals("short")?6:8).put("sha256",invalid.equals("missing-hash")?"":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
            httpClient.code=409;httpClient.routes.put("http://fake/v1/audio-receipt?client_session_id="+id,new Response(200,receipt.toString()));
            drainPendingVoiceQueue();waitFor(()->!pendingDrainRunning.get());barrier();
            assertTrue(invalid,voicePendingQueue.pcmFile(id).exists());assertFalse(voicePendingQueue.receiptConfirmed(id));
            assertTrue("conflict must raise visible notice",status.contains("衝突"));assertFalse("conflict must back off",voicePendingQueue.due(id,System.currentTimeMillis()));
        }
    }
