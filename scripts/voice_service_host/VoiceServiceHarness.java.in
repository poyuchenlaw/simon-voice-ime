    @Test public void lifecycleCallbacksFlushPendingPcm()throws Exception {
        for(int callback=0;callback<4;callback++) {
            String id=voicePendingQueue.beginAsync();voicePendingQueue.appendAsync(id,new byte[]{1,2},2);barrier();
            voicePendingQueue.appendAsync(id,new byte[]{3,4},2);barrier();
            switch(callback){case 0:onFinishInputView(true);break;case 1:onDestroy();break;case 2:onLowMemory();break;default:onTrimMemory(80);}
            barrier();assertEquals("lifecycle must eventually flush queued PCM",4,voicePendingQueue.pcmFile(id).length());
        }
    }
