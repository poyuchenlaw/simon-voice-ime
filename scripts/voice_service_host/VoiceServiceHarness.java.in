    @Test public void missingFirstFinalHasBoundedRelease()throws Exception {
        String first=session(1);voicePendingQueue.holdForReceipt(first);
        sendAudioEndOfStream(new WebSocket(),first);barrier();
        for(int gen=2;gen<=4;gen++){String id=session(gen);voicePendingQueue.holdForReceipt(id);wsFinal(new JSONObject().put("text","段"+gen),gen);}
        barrier();assertTrue(connection.inserted.isEmpty());
        for(Runnable r:new ArrayList<>(mainHandler.delayed))r.run();barrier();
        assertEquals(Arrays.asList("段2","段3","段4"),connection.inserted);
        assertFalse(pendingSessionByGeneration.containsKey(1));files(first,true);
    }
    @Test public void fiveNormalFinalsStayOrderedAndExactlyOnce()throws Exception {
        for(int gen=1;gen<=5;gen++)voicePendingQueue.holdForReceipt(session(gen));
        for(int gen:new int[]{5,3,1,4,2})wsFinal(new JSONObject().put("text","段"+gen),gen);
        barrier();assertEquals(Arrays.asList("段1","段2","段3","段4","段5"),connection.inserted);
        wsFinal(new JSONObject().put("text","段1"),1);barrier();assertEquals(5,connection.inserted.size());
    }
    @Test public void audibleEmptyFinalRecoversButDoesNotHoldLaterFinal()throws Exception {
        String first=session(1);voicePendingQueue.holdForReceipt(first);audibleVoiceGenerations.add(1);
        String second=session(2);voicePendingQueue.holdForReceipt(second);
        wsFinal(new JSONObject().put("text",""),1);wsFinal(new JSONObject().put("text","第二段"),2);barrier();
        assertEquals(Arrays.asList("第二段"),connection.inserted);assertTrue(recoverySessionByGeneration.containsKey(1));files(first,true);
        httpFallbackFullAudio(1);assertTrue("no concurrent alternate-session upload",httpClient.callbacks.isEmpty());
    }
    String unfinishedSession(int gen)throws Exception {String id=voicePendingQueue.begin();voicePendingQueue.append(id,new byte[32000],32000);pendingSessionByGeneration.put(gen,id);return id;}
    @Test public void closeImmediatelyAfterStopRecoversStillActiveSession()throws Exception {
        String id=unfinishedSession(1);voicePendingQueue.holdForReceipt(id);activePendingSessionId=id;
        isRecording=false;recordingFinalizing=false;activeUtteranceGeneration=1;
        recoverUnfinishedVoiceGeneration(1,"ws_closed_without_final");barrier();
        assertFalse("recovered generation must no longer block drain",pendingSessionByGeneration.containsKey(1));
        assertEquals("pending",new JSONObject(new String(java.nio.file.Files.readAllBytes(new File(temp.getRoot(),"voice_pending/"+id+".json").toPath()))).getString("state"));
        files(id,true);voicePendingQueue.releaseReceiptWait(id);assertTrue(voicePendingQueue.pendingOldestFirst().contains(id));httpClient.code=200;
        drainPendingVoiceQueue();waitFor(()->!pendingDrainRunning.get());barrier();
        assertEquals(Arrays.asList("queued words"),clipboardHelper.history);files(id,false);
    }
    @Test public void authSendFallbackEscapesPasswordAndPreservesSession()throws Exception {
        authPassword="quote\" slash\\ newline\n";
        WebSocket ws=new WebSocket(){int calls;@Override boolean send(String msg){messages.add(msg);return ++calls!=1;}};
        wsOpen(ws,new Response(101,""),"test-session","before","after",1);
        assertEquals(2,ws.messages.size());JSONObject fallback=new JSONObject(ws.messages.get(1));
        assertEquals(authPassword,fallback.getString("password"));assertEquals("auth",fallback.getString("type"));
        assertEquals("test-session",fallback.getString("client_session_id"));
    }
    @Test public void hundredImmediateStopClosesBecomePendingAndEligible()throws Exception {
        // Keep the transport idle while counting recovered pending slots; upload state is transient.
        pendingDrainRunning.set(true);
        for(int gen=1;gen<=100;gen++) {
            String id=unfinishedSession(gen);voicePendingQueue.holdForReceipt(id);activePendingSessionId=id;
            activeUtteranceGeneration=gen;isRecording=false;recordingFinalizing=false;
            recoverUnfinishedVoiceGeneration(gen,"ws_closed_without_final");barrier();
            assertFalse(pendingSessionByGeneration.containsKey(gen));assertNull(activePendingSessionId);
            assertEquals("pending",new JSONObject(new String(java.nio.file.Files.readAllBytes(new File(temp.getRoot(),"voice_pending/"+id+".json").toPath()))).getString("state"));
        }
        // Receipt wait is independent: releasing it exposes every recovered recording to drain.
        for(String id:recoverySessionByGeneration.values())voicePendingQueue.releaseReceiptWait(id);
        assertEquals(100,voicePendingQueue.pendingOldestFirst().size());
    }
