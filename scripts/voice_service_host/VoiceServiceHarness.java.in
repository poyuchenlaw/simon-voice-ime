    @Test public void voiceStageTraceLinksDeliveryWithoutContent() throws Exception {
        String id=session(1);voicePendingQueue.holdForReceipt(id);
        wsFinal(new JSONObject().put("text","正確文字"),1);barrier();
        List<String> stages=new ArrayList<>();
        for(JSONObject e:imeTelemetry.events){stages.add(e.getString("stage"));assertEquals(id,e.getString("client_session_id"));assertEquals(1,e.getInt("generation"));assertEquals(2000,e.getLong("elapsed_ms"));assertEquals(1800,e.getLong("uptime_ms"));assertFalse(e.has("text"));assertFalse(e.has("package"));assertEquals("release".equals(e.getString("stage")),e.has("next_generation"));}
        assertEquals(Arrays.asList("ws_main_post","ws_main_run","admit","release","io_begin","io_end","io_main_post","io_main_run","commit"),stages);
        assertEquals("ic_api_true",imeTelemetry.events.get(8).getString("commit_outcome"));assertEquals("commit",imeTelemetry.events.get(8).getString("insert_method"));
        imeTelemetry.events.clear();protectedInputField=true;recordVoiceStage("stop",1,id,null);assertTrue(imeTelemetry.events.isEmpty());protectedInputField=false;
        recordVoiceStage("stop",1,id,null);assertEquals("stop",imeTelemetry.events.get(0).getString("stage"));imeTelemetry.events.clear();
        for(boolean absent:new boolean[]{true,false}){imeTelemetry.events.clear();int gen=absent?2:3;String sid=session(gen);voicePendingQueue.holdForReceipt(sid);missingInputConnection=absent;connection.fail=true;connection.pasteFails=true;wsFinal(new JSONObject().put("text","保留文字"),gen);barrier();JSONObject e=imeTelemetry.events.get(imeTelemetry.events.size()-1);assertEquals("commit",e.getString("stage"));assertEquals(absent?"no_ic":"ic_api_false",e.getString("commit_outcome"));}
        imeTelemetry.events.clear();String deadlineId=session(4);isRecording=true;activeUtteranceGeneration=4;armVoiceFinalDeadline(4);voiceFinalDeadlines.get(4).run();assertEquals("deadline",imeTelemetry.events.get(0).getString("stage"));assertEquals(deadlineId,imeTelemetry.events.get(0).getString("client_session_id"));assertEquals(1,afterRecordingFinalization.size());isRecording=false;
        connection.fail=true;connection.pasteFails=false;commitFinalText("貼上成功");assertEquals("ic_api_true",lastVoiceCommitOutcome);assertEquals("paste",lastCommitMethod);
        commitFinalText("");assertEquals("not_attempted",lastVoiceCommitOutcome);
        connection.throwsCommit=true;missingInputConnection=false;imeTelemetry.events.clear();wsFinal(new JSONObject().put("text","仍應保留"),4);barrier();assertEquals("ic_api_exception",imeTelemetry.events.get(imeTelemetry.events.size()-1).getString("commit_outcome"));assertTrue(clipboard.values.contains("仍應保留"));
    }

    @Test public void voiceStageEmitterExceptionNeverSkipsDelivery() throws Exception {
        String id=session(1);voicePendingQueue.holdForReceipt(id);((GuardSet)discardedProtectedSessions).throwOnce=true;
        wsFinal(new JSONObject().put("text","診斷不得擋出字"),1);barrier();assertEquals(Arrays.asList("診斷不得擋出字"),connection.inserted);
    }

    @Test public void voiceStageCommitFalsePasteTrueIsReported() throws Exception {
        String id=session(1);voicePendingQueue.holdForReceipt(id);connection.fail=true;connection.pasteFails=false;
        wsFinal(new JSONObject().put("text","貼上仍應出字"),1);barrier();JSONObject e=imeTelemetry.events.get(imeTelemetry.events.size()-1);
        assertEquals("commit",e.getString("stage"));assertEquals("ic_api_true",e.getString("commit_outcome"));assertEquals("paste",e.getString("insert_method"));assertEquals(1,connection.pastes);
    }

    @Test public void voiceStageInterleavedHandoffsStayDistinct() throws Exception {
        String id=session(1);voicePendingQueue.holdForReceipt(id);CountDownLatch entered=new CountDownLatch(1),release=new CountDownLatch(1);
        voicePendingQueue.execute(()->{entered.countDown();try{release.await();}catch(InterruptedException e){Thread.currentThread().interrupt();}});assertTrue(entered.await(2,TimeUnit.SECONDS));
        try {
            wsFinal(new JSONObject().put("text","一次交付"),1);wsFinal(new JSONObject().put("text","一次交付"),1);
            List<String> stages=new ArrayList<>();for(JSONObject e:imeTelemetry.events)stages.add(e.getString("stage"));
            assertEquals(Arrays.asList("ws_main_post","ws_main_run","admit","release","io_begin","ws_main_post","ws_main_run"),stages);
        }finally{release.countDown();}barrier();
        List<String> tail=new ArrayList<>();for(int n=7;n<imeTelemetry.events.size();n++)tail.add(imeTelemetry.events.get(n).getString("stage"));assertEquals(Arrays.asList("io_end","io_main_post","io_main_run","commit"),tail);assertEquals(Arrays.asList("一次交付"),connection.inserted);
    }

    @Test public void authoritativeFinalPlaintextIsDeliveredVerbatim() throws Exception {
        String[] texts={"請保留 <sil> 這個字串，供工程日誌比對。","<hallucination>","　 保留前後空白與 [BLANK_AUDIO] 　"};
        for(int n=0;n<texts.length;n++){String id=session(n+1);voicePendingQueue.holdForReceipt(id);wsFinal(new JSONObject().put("text",texts[n]).put("asr_complete",true),n+1);barrier();assertEquals(Arrays.asList(Arrays.copyOf(texts,n+1)),connection.inserted);assertEquals(texts[n],clipboard.values.get(n));}
    }

    @Test public void malformedWsFinalNeverInventsTextAndRetainsAudio() throws Exception {
        String id=session(1);voicePendingQueue.holdForReceipt(id);wsFinal(new JSONObject().put("text",new JSONObject().put("bad","object")),1);barrier();
        assertTrue("malformed transport must not stringify object into App",connection.inserted.isEmpty());assertTrue(clipboard.values.isEmpty());files(id,true);
    }

