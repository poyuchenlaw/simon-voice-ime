    @Test public void stalledNetworkSinkDoesNotBlockDurableRecordingWrites()throws Exception {
        String old=session(1);RequestBody body=pcmWavBody(voicePendingQueue.pcmFile(old),16000);BufferedSink sink=new BufferedSink();sink.entered=new CountDownLatch(1);sink.release=new CountDownLatch(1);
        sink.writesBeforeStall=1; // Header passes; stall on a PCM-bearing write, not just the header.
        ExecutorService network=Executors.newSingleThreadExecutor(),writer=Executors.newSingleThreadExecutor();Future<?> upload=network.submit(()->{try{body.writeTo(sink);}catch(IOException e){throw new IllegalStateException(e);}});
        assertTrue(sink.entered.await(3,TimeUnit.SECONDS));String fresh=voicePendingQueue.beginAsync();pendingSessionByGeneration.put(2,fresh);persistRecordingRead(fresh,new byte[]{7,8},2);
        try{assertArrayEquals(new byte[]{7,8},writer.submit(()->voicePendingQueue.pcmBytes(fresh)).get(2,TimeUnit.SECONDS));}
        finally{sink.release.countDown();upload.get(3,TimeUnit.SECONDS);network.shutdown();writer.shutdown();finishDurableRecording(fresh);}
    }
    @Test public void legacyDiscardNeedsExplicitNoCustodyConfirmation()throws Exception {
        for(int statusCode:new int[]{404,405})for(String custody:new String[]{"present","absent","unknown"}) {
            String id=session(utteranceGeneration.incrementAndGet());activePendingSessionId=id;
            httpClient.routes.put("http://fake/v1/audio-archive?client_session_id="+id,new Response(statusCode,"{}"));
            httpClient.routes.put("http://fake/v1/audio-receipt?client_session_id="+id,new Response(custody.equals("present")?200:404,custody.equals("absent")?"{\"detail\":\"Audio receipt not found\"}":"{}"));
            discardProtectedRecording();barrier();waitFor(()->!pendingDrainRunning.get());
            assertEquals("404/405 alone never proves absent custody",!custody.equals("absent"),voicePendingQueue.pendingServerDiscards().contains(id));
        }
    }
