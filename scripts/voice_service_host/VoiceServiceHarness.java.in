    @Test public void delayedNormalWsDeliveryDoesNotReplayClipboardAfterReceiptRelease()throws Exception {
        String id=session(1);voicePendingQueue.holdForReceipt(id);JSONObject receipt=identity(id);
        mainHandler.deferPosts=true;wsFinal(new JSONObject().put("text","正常合成結果"),1);barrier();
        assertTrue(mainHandler.posts.size()>0);
        // Run the normal-final main callback; persistResult then queues the delivery callback.
        mainHandler.posts.remove(0).run();barrier();assertTrue(mainHandler.posts.size()>0);
        receiveAudioReceipt(id,receipt);barrier();voicePendingQueue.releaseReceiptWait(id);
        drainPendingVoiceQueue();waitFor(()->!pendingDrainRunning.get());barrier();
        assertTrue("normal in-flight delivery remains owned by generation",pendingSessionByGeneration.containsValue(id));assertEquals(0,httpClient.calls.get());assertTrue(connection.inserted.isEmpty());assertTrue(clipboard.values.isEmpty());
        Thread.sleep(1000);mainHandler.deferPosts=false;for(Runnable delivery:new ArrayList<>(mainHandler.posts)){mainHandler.posts.remove(delivery);delivery.run();}barrier();
        assertEquals(Arrays.asList("正常合成結果"),connection.inserted);assertEquals(Arrays.asList("正常合成結果"),clipboard.values);
        List<String> history=new ArrayList<>(clipboardHelper.history);clipboard.setPrimaryClip(new ClipData("使用者後續複製"));
        drainPendingVoiceQueue();waitFor(()->!pendingDrainRunning.get());barrier();
        assertEquals(Arrays.asList("正常合成結果","使用者後續複製"),clipboard.values);assertEquals(history,clipboardHelper.history);assertEquals(0,httpClient.calls.get());
    }
