    @Test public void stopTimeoutWaitsForTailWithoutAnotherBlockingJoin()throws Exception {
        CountDownLatch entered=new CountDownLatch(1),release=new CountDownLatch(1);
        Thread recorder=new Thread(()->{entered.countDown();try{release.await();}catch(InterruptedException e){Thread.currentThread().interrupt();}});recorder.start();
        assertTrue(entered.await(3,TimeUnit.SECONDS));ExecutorService caller=Executors.newSingleThreadExecutor();
        try {
            caller.submit(()->finishWhenRecorderStopped(recorder,false,7,"exact-tail-session")).get(2,TimeUnit.SECONDS);
            assertEquals(0,stoppedFinalizations);assertEquals(Long.valueOf(100),mainHandler.delays.get(mainHandler.delays.size()-1));
        } finally {release.countDown();recorder.join(3000L);caller.shutdown();}
        assertFalse(recorder.isAlive());mainHandler.delayed.get(mainHandler.delayed.size()-1).run();
        assertEquals(1,stoppedFinalizations);assertEquals(7,finalizedGeneration);assertEquals("exact-tail-session",finalizedSession);
    }

