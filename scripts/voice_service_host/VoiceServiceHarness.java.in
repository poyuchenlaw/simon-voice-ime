    @Test public void missingWsReceiptUsesBoundedGetThenArchiveBackoff()throws Exception {
        String id=session(1);pendingSessionByGeneration.clear();httpClient.code=200;finishDurableRecording(id);
        waitFor(()->!new File(temp.getRoot(),"voice_pending/"+id+".pcm").exists());waitFor(()->!pendingDrainRunning.get());barrier();files(id,false);
        assertEquals(4,httpClient.requestUrls.size());
        for(int i=0;i<3;i++)assertTrue(httpClient.requestUrls.get(i).contains("/v1/audio-receipt?client_session_id="+id));
        assertTrue(httpClient.requestUrls.get(3).endsWith("/v1/audio-archive"));
        assertTrue(httpClient.requestTimes.get(1)-httpClient.requestTimes.get(0)>=TimeUnit.MILLISECONDS.toNanos(500));
        assertTrue(httpClient.requestTimes.get(2)-httpClient.requestTimes.get(1)>=TimeUnit.MILLISECONDS.toNanos(1000));
        assertEquals(Arrays.asList("queued words"),clipboardHelper.history);assertEquals("automatic recovery updates primary clipboard once",clipboardHelper.history,clipboard.values);assertTrue(connection.inserted.isEmpty());
    }
    @Test public void lostWsReceiptRecoversMatchingGetWithoutArchive()throws Exception {
        String id=session(1);pendingSessionByGeneration.clear();JSONObject original=identity(id);httpClient.code=200;
        httpClient.routes.put("http://fake/v1/audio-receipt?client_session_id="+id,new Response(200,original.toString()));
        // Stopped sessions may drain text owed after custody. Supply the real contract
        // for that independent lookup; the complete original in this fixture is digital zero.
        httpClient.routes.put("http://fake/v1/audio-archive/transcribe",new Response(200,new JSONObject().put("text","").put("receipt",original).toString()));
        finishDurableRecording(id);waitFor(()->audioReceiptWaiters.isEmpty());
        waitFor(()->"沒有錄到聲音".equals(status)&&!pendingDrainRunning.get());barrier();files(id,false);
        assertEquals(2,httpClient.requestUrls.size());assertEquals("http://fake/v1/audio-receipt?client_session_id="+id,httpClient.requestUrls.get(0));
        assertEquals("http://fake/v1/audio-archive/transcribe",httpClient.requestUrls.get(1));assertTrue(clipboard.values.isEmpty());
        assertFalse(voicePendingQueue.pendingOldestFirst().contains(id));
    }
    @Test public void wsZeroIdentityAfterPublicAppendFailureCannotSettle()throws Exception {
        String id=session(1);voicePendingQueue.holdForReceipt(id);
        try {voicePendingQueue.append(id,new byte[]{1},2);fail("invalid public write must fail");}
        catch(Exception expected){}
        assertTrue("public append failure recorded",voicePendingQueue.backupFailed(id));
        JSONObject m=new JSONObject(new String(java.nio.file.Files.readAllBytes(new File(temp.getRoot(),"voice_pending/"+id+".json").toPath()),java.nio.charset.StandardCharsets.UTF_8));
        assertTrue("durable failure marker",m.getBoolean("local_write_failed"));
        JSONObject original=identity(id);assertEquals(32000,original.getLong("byte_count"));
        wsFinal(new JSONObject().put("text",""),1);barrier();
        assertFalse("known failed local recording is not complete digital silence",voicePendingQueue.delivered(id));
        assertFalse(deliveredVoiceGenerations.contains(1));files(id,true);
    }
    @Test public void wsSilenceKeepsExistingDeadlineUntilWorkerProofCompletes()throws Exception {
        String id=session(1);voicePendingQueue.holdForReceipt(id);armVoiceFinalDeadline(1);
        mainHandler.deferPosts=true;wsFinal(new JSONObject().put("text",""),1);
        Runnable finalCallback=mainHandler.posts.remove(0);
        CountDownLatch entered=new CountDownLatch(1),release=new CountDownLatch(1);
        voicePendingQueue.execute(()->{entered.countDown();try{release.await(5,TimeUnit.SECONDS);}catch(InterruptedException e){Thread.currentThread().interrupt();}});
        boolean retained;
        try {assertTrue(entered.await(3,TimeUnit.SECONDS));finalCallback.run();retained=voiceFinalDeadlines.containsKey(1);}
        finally {release.countDown();barrier();mainHandler.deferPosts=false;for(Runnable r:new ArrayList<>(mainHandler.posts)){mainHandler.posts.remove(r);r.run();}barrier();}
        assertTrue("existing35s final deadline must survive pending IO proof",retained);
        assertFalse(voiceFinalDeadlines.containsKey(1));assertTrue(voicePendingQueue.delivered(id));
        consumeSilentResult(1,"");recoverUnfinishedVoiceGeneration(1,"duplicate_close");
        assertTrue(clipboard.values.isEmpty());assertTrue(clipboardHelper.history.isEmpty());files(id,true);
    }

