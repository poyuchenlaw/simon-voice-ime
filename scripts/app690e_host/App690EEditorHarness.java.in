package com.simon.voiceime;
import java.util.*;import java.io.*;import org.junit.*;import static org.junit.Assert.*;
public class App690EEditorHarness {
 static class ExtractedText {String text;int startOffset=0,selectionStart,selectionEnd,partialStartOffset=-1,partialEndOffset=-1;}
 static class ExtractedTextRequest {int hintMaxChars,hintMaxLines;}
 static class InputConnection {String text="銀行甲";int start=2,end=2,writes,batch;boolean reject,mutateOnSelect;
  ExtractedText getExtractedText(ExtractedTextRequest r,int flags){ExtractedText e=new ExtractedText();e.text=text;e.selectionStart=start;e.selectionEnd=end;return e;}
  boolean beginBatchEdit(){batch++;return true;}boolean endBatchEdit(){batch--;return true;}
  boolean setSelection(int a,int b){start=a;end=b;if(mutateOnSelect){text="甲"+text;mutateOnSelect=false;}return true;}
  boolean commitText(String value,int position){writes++;if(reject)return false;text=text.substring(0,start)+value+text.substring(end);start=end=start+value.length();return true;}
 }
 static class Service {InputConnection connection=new InputConnection();boolean protectedField,own;long field=1;
  InputConnection getCurrentInputConnection(){return connection;}boolean dualHandProtected(){return protectedField;}boolean dualHandSelfUpdate(){return own;}boolean correctionSelfUpdate(){return own;}long dualHandFieldGeneration(){return field;}void dualHandFinishComposition(){}void dualHandStatus(String s){}void correctionSelfWrite(int start,int end){own=true;}}
 static class Handler {List<Runnable> tasks=new ArrayList<>();void removeCallbacks(Runnable r){tasks.remove(r);}void postDelayed(Runnable r,int ms){tasks.add(r);}void run(){List<Runnable> copy=new ArrayList<>(tasks);tasks.clear();copy.forEach(Runnable::run);}}
 static class SystemClock {static long time=1000;static long uptimeMillis(){return time;}}
 static class ViewTreeObserver {interface OnPreDrawListener{boolean onPreDraw();}OnPreDrawListener listener;boolean isAlive(){return true;}void addOnPreDrawListener(OnPreDrawListener l){listener=l;}void removeOnPreDrawListener(OnPreDrawListener l){if(listener==l)listener=null;}}
 static class View {ViewTreeObserver observer=new ViewTreeObserver();ViewTreeObserver getViewTreeObserver(){return observer;}}
 static class Page {View view=new View();View view(){return view;}final DualHandState state=new DualHandState(null);String name="bopomofo";boolean blocked,dual,reverse;DualHandState buffer(){return state;}boolean dual(){return dual;}boolean blocked(){return blocked;}boolean reverseOnly(){return reverse;}String name(){return name;}void refresh(){}}
 final Service service=new Service();final Handler ui=new Handler();final Page page=new Page();DualHandTracks tracks;DualHandMemory memory;boolean closed;Runnable selectionTask;int compositionStart=-1,compositionEnd=-1;int beforeCompositionEnd=-1;Snapshot beforeWrite;Snapshot witness,lastTapOwner;int lastTapPosition=-1;long lastTapTime=-1000;final CorrectionRecords records=new CorrectionRecords();final Map<Integer,String> positions=records.positions;final CorrectionCounters counters=new CorrectionCounters();View guardView;ViewTreeObserver.OnPreDrawListener pageGuard;Object marker,popup;int markers,grids;Snapshot owner;List<DualHandTracks.Choice> displayed;
 @Before public void load()throws Exception {tracks=new DualHandTracks(new FileReader("src/phone/assets/dual_hand/phrase_words.tsv"),new FileReader("src/phone/assets/dual_hand/grid_chars.tsv"),new FileReader("src/phone/assets/dual_hand/readings.tsv"));SystemClock.time+=1000;}
 void cancelCall(String s){}void dismissGrid(){counters.cancel();}void dismissMarker(){markers=0;}void cancel(boolean clear){ui.tasks.clear();markers=grids=0;if(clear){records.clear();witness=null;}}void gridEvent(String s,int index,int rank,boolean p){counters.choose(rank);}
 void showMarker(Snapshot s,int base,int index,boolean composing){if(!choices(s,base,index,composing).isEmpty())markers++;}
 void openGrid(Snapshot s,int base,int index,boolean composing){displayed=choices(s,base,index,composing);if(!displayed.isEmpty()){grids++;owner=s;counters.open(page.name());}}
 /* METHODS */
 @Test public void recordingStartsWithVisibleCapsuleClosesOnNextDraw(){markers=1;guardPage();page.blocked=true;assertTrue(page.view.observer.listener.onPreDraw());assertEquals(0,markers);}
 @Test public void dualRetainsTypedReadingForAiWrongGlyphAs6891Did(){page.dual=true;service.connection.text="銀";service.connection.start=service.connection.end=1;committed(page,"銀",Collections.singletonList("ㄏㄤ"));assertEquals("ㄏㄤ",records.reading(0,"銀"));}
 @Test public void dualUnrecordedReplacementStillUsesReverseLookup(){page.dual=true;Snapshot s=snapshot();replaceCommitted(s,0,s.text,new DualHandTracks.Choice("航",1,2,1,false,0,List.of("ㄏㄤ")),1,4);assertFalse("uncached replacement must still offer homophones",choices(snapshot(),0,1,false).isEmpty());}
 @Test public void sameReadingsProduceIdenticalGridOnThreePages(){records.record(0,"銀行",List.of("ㄧㄣ","ㄏㄤ"),tracks,false);Snapshot s=snapshot();List<String> reference=new ArrayList<>();for(DualHandTracks.Choice c:choices(s,0,1,false))reference.add(c.text);page.dual=true;List<String> dual=new ArrayList<>();for(DualHandTracks.Choice c:choices(s,0,1,false))dual.add(c.text);assertEquals(reference,dual);page.dual=false;page.reverse=true;List<String> voice=new ArrayList<>();for(DualHandTracks.Choice c:choices(s,0,1,false))voice.add(c.text);assertEquals(tracks.grid(List.of(tracks.readings("銀"),tracks.readings("行"),tracks.readings("甲")),1).stream().map(c->c.text).collect(java.util.stream.Collectors.toList()),voice);}
 @Test public void replacementChangesOnlyTargetAndRestoresCursor(){Snapshot s=snapshot();replaceCommitted(s,0,s.text,new DualHandTracks.Choice("航",1,2,1,false,0,List.of("ㄏㄤ")),1,4);assertEquals("銀航甲",service.connection.text);assertEquals(2,service.connection.start);assertEquals(2,service.connection.end);assertEquals(1,service.connection.writes);assertEquals(0,service.connection.batch);}
 @Test public void changedTextBetweenOpenAndChoiceDoesNotWrite(){Snapshot s=snapshot();service.connection.text="甲銀行甲";replaceCommitted(s,0,s.text,new DualHandTracks.Choice("航",1,2,1),1,4);assertEquals(0,service.connection.writes);}
 @Test public void mutationDuringSelectionDoesNotWrite(){Snapshot s=snapshot();service.connection.mutateOnSelect=true;replaceCommitted(s,0,s.text,new DualHandTracks.Choice("航",1,2,1),1,4);assertEquals(0,service.connection.writes);assertEquals(0,service.connection.batch);}
 @Test public void passwordCompositionRecordingAndOwnSelectionNeverOfferMarker(){for(int mode=0;mode<4;mode++){service.protectedField=mode==0;page.blocked=mode==1||mode==2;service.own=mode==3;selection(page,2,2,-1,-1);ui.run();assertEquals(0,markers);assertEquals(0,grids);}service.own=false;page.blocked=false;selection(page,2,2,0,3);ui.run();assertEquals(0,markers);}
 @Test public void externalInsertRebasesAndChangedGlyphFallsBack(){records.record(0,"銀行",List.of("ㄧㄣ","ㄏㄤ"),tracks,false);witness=snapshot();service.connection.text="甲銀行甲";service.connection.start=service.connection.end=3;validate(snapshot());assertEquals("ㄏㄤ",records.reading(2,"行"));witness=snapshot();service.connection.text="甲銀星甲";validate(snapshot());assertNull(records.reading(2,"星"));}
 @Test public void nonHanHasNoCandidateAndDoubleTapRemains500Ms(){service.connection.text="xyz";service.connection.start=service.connection.end=2;selection(page,2,2,-1,-1);ui.run();assertEquals(0,markers);service.connection.text="銀行甲";lastTapOwner=null;selection(page,2,2,-1,-1);ui.run();assertEquals(1,markers);SystemClock.time+=500;selection(page,2,2,-1,-1);assertEquals(1,grids);}
 @Test public void fieldChangeClearLeavesNoRecordsOrPendingMarker(){records.record(0,"銀行",List.of("ㄧㄣ","ㄏㄤ"),tracks,false);selection(page,2,2,-1,-1);cancel(true);ui.run();assertEquals(0,records.size());assertEquals(0,markers);}
}
