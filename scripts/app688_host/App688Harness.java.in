 }
 @Test public void b6881_bottomKeysReachStateAndDispatch()throws Exception {
  String[] bottom={"tools","symbols","Ø","clipboard","core"};
  String[] directions={"tap","up","left","down","right"};
  String[][] want={{"finish,to41","finish,settings","finish,toEnglish","finish,hide","finish,toVoice"},
   {"space","finish,、","finish,symbols","finish,。","finish,，"},
   {"","ㄧ","ㄦ","ㄩ","ㄨ"},
   {"finish,clipboard","finish,commands","vibrate","vibrate","vibrate"},
   {"finish,enter","erase","restore","ai","finish,enter"}};
  List<String> failures=new ArrayList<>();
  for(int row=0;row<bottom.length;row++)for(int col=0;col<directions.length;col++){
   String key=bottom[row],direction=directions[col];state=new DualHandState(table);service.calls.clear();
   try{
    DualHandState.Stroke stroke=state.begin(key,100);state.end(stroke,direction,false);
    List<DualHandState.Output> ready=state.drain(141);assertEquals(1,ready.size());
    DualHandState.Output output=ready.get(0);assertEquals(key,output.stroke.key);assertEquals(direction,output.direction);
    if("Ø".equals(key)){
     assertEquals(want[row][col],output.syllable);assertEquals(col==0,output.empty);
     assertEquals(col==0?List.of():List.of(want[row][col]),state.syllables());assertTrue(service.calls.isEmpty());
    }else{
     assertFalse(output.empty);assertEquals("",output.syllable);function(output.stroke.key,output.direction);
     assertEquals(Arrays.asList(want[row][col].split(",")),service.calls);assertEquals("",state.draft());
    }
   }catch(IllegalArgumentException|AssertionError failure){failures.add(key+":"+direction+" "+failure);}
  }
  assertEquals("5 bottom keys x 5 directions via begin/end/drain/dispatch",List.of(),failures);
  System.out.println("6.88.1 bottom state/dispatch: 25 gestures, exact effects verified");
 }
 @Test public void b6881_clipboardNoOpPreservesDraft()throws Exception {
  for(String direction:new String[]{"left","down","right"}){
   state=new DualHandState(table);DualHandState.Stroke letter=state.begin("Ø",100);state.end(letter,"up",false);state.drain(141);
   String before=state.draft();List<String> syllables=state.syllables();service.calls.clear();
   DualHandState.Stroke stroke=state.begin("clipboard",200);state.end(stroke,direction,false);
   for(DualHandState.Output output:state.drain(241))function(output.stroke.key,output.direction);
   assertEquals(List.of("vibrate"),service.calls);assertEquals(before,state.draft());assertEquals(syllables,state.syllables());
  }
 }
