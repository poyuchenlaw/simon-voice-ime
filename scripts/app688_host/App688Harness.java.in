 @Test public void f_shortRightAndTap()throws Exception {java.lang.reflect.Method m;try{m=DualHandGesture.class.getMethod("classify",String.class,float.class,float.class,long.class,float.class,int.class);}catch(NoSuchMethodException missing){fail("right hand threshold missing");return;}for(String key:new String[]{"A","B","C","D","E","F","Ø","clipboard","core"}){assertEquals("right",((DualHandGesture.Result)m.invoke(null,key,9.1f,0f,40L,9.1f,2)).direction);assertEquals("tap",((DualHandGesture.Result)m.invoke(null,key,8.9f,0f,120L,8.9f,2)).direction);assertEquals("tap",((DualHandGesture.Result)m.invoke(null,key,0f,-10f,120L,10f,2)).direction);}assertEquals("tap",((DualHandGesture.Result)m.invoke(null,"1",10f,0f,120L,10f,2)).direction);}
