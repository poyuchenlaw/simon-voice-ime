 @Test public void b_bottomActions()throws Exception {
  String[][] want={{"to41","settings","toEnglish","hide","toVoice"},{"space","、","symbols","。","，"},{"clipboard","commands","vibrate","vibrate","vibrate"},{"enter","erase","restore","ai","enter"}};
