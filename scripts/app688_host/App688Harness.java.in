 @Test public void b_bottomActions()throws Exception {
  String[][] want={{"to41","settings","toEnglish","hide","toVoice"},{"space","、","symbols","。","，"},{"clipboard","commands","vibrate","vibrate","vibrate"},{"enter","erase","restore","ai","enter"}};
  String[] ks={"tools","symbols","clipboard","core"};
  for(int j=0;j<4;j++)for(int i=0;i<5;i++){service.calls.clear();function(ks[j],DualHandTable.DIRECTIONS[i]);assertTrue(ks[j]+":"+DualHandTable.DIRECTIONS[i]+" "+service.calls,service.calls.contains(want[j][i]));}
  String[] zero={"","ㄧ","ㄦ","ㄩ","ㄨ"};for(int i=0;i<5;i++)assertEquals(zero[i],table.right(null,"Ø",DualHandTable.DIRECTIONS[i]));
  renderLabels();assertEquals("空白",labels.get("symbols").get("tap").value);assertEquals("送出",labels.get("core").get("tap").value);assertEquals("⚙",labels.get("tools").get("up").value);assertEquals("剪貼簿",labels.get("clipboard").get("tap").value);assertEquals("常用詞",labels.get("clipboard").get("up").value);
 }
