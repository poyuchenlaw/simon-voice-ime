 @Test public void g_everyLabelAtLeast12sp()throws Exception {
  labelSizeSp=fitLabelSize(400);keys.clear();labels.clear();half(new String[][]{{"1","2"},{"3","4"},{"5","6"},{"A","B"},{"C","D"},{"E","F"},{"tools","symbols","Ø","clipboard","core"}});
  renderState=null;renderLabels();for(Map<String,TextView> parts:labels.values())for(TextView label:parts.values())assertTrue("all label characters >=12sp, text="+label.value+" size="+label.size,label.size>=12);
 }
 @Test public void g_widthConstraints()throws Exception {
  java.lang.reflect.Method m;try{m=getClass().getDeclaredMethod("columnWidths",int.class);}catch(NoSuchMethodException missing){fail("independent bottom widths and asymmetric halves missing");return;}m.setAccessible(true);
  for(int width:new int[]{320,360,400,600,800}){int[] cols=(int[])m.invoke(this,width);assertEquals(7,cols.length);assertTrue("midline left",cols[0]<cols[1]);assertTrue("left keys >=64dp",cols[0]/2-4>=64);assertTrue("Ø >=64dp",cols[4]-4>=64);int total=0;for(int i=2;i<7;i++)total+=cols[i];assertEquals(width-6,total);}
 }
 @Test public void g_fractionalDensityKeepsTouchWidths()throws Exception {
  try{for(float density:new float[]{1.3f,1.5f,2.625f,2.75f,3f}){
   android.util.DisplayMetrics.density=density;android.util.DisplayMetrics.scaledDensity=density;
   int[] cols=columnWidths(Math.round(360*density));
   assertTrue("left >=64dp at density="+density,cols[0]/2-2*dp(2)>=64*density);
   assertTrue("Ø >=64dp at density="+density,cols[4]-2*dp(2)>=64*density);
   for(int logical:new int[]{320,360,400}){int screen=Math.round(logical*density);int[] widths=columnWidths(screen);float sp=fitLabelSize(screen);assertTrue("fractional density geometry "+density+" screen "+logical,allRenderedLabelsFit(sp,screen,widths));}
  }}finally{android.util.DisplayMetrics.density=android.util.DisplayMetrics.scaledDensity=1;}
 }
 // Check rendered view bounds independently of the production fits() decision.
 boolean allRenderedLabelsFit(float sp){return allRenderedLabelsFit(sp,400,columnWidths(400));}
 boolean allRenderedLabelsFit(float sp,int screenWidth,int[] columns){
  List<String> states=new ArrayList<>();states.add(null);states.addAll(Arrays.asList(DualHandTable.STATES));
  android.graphics.Paint paint=new android.graphics.Paint();paint.setTextSize(sp);
  for(String pending:states){renderState=pending;renderLabels();
   for(String key:new String[]{"1","2","3","4","5","6","A","B","C","D","E","F","Ø","tools","symbols","clipboard","core"}){
    boolean letter=DualHandTable.isLeft(key)||DualHandTable.isRight(key);paint.setTextSize((letter?sp:12)*android.util.DisplayMetrics.scaledDensity);
    int inset=2*dp(2)+2*dp(1);float height=dp(78)-inset;
    float width=DualHandTable.isLeft(key)?columns[0]/2-inset:!key.equals("Ø")&&DualHandTable.isRight(key)?columns[1]/2-inset:columns[2+List.of("tools","symbols","Ø","clipboard","core").indexOf(key)]-inset;
    List<float[]> occupied=new ArrayList<>();
    for(TextView label:keys.get(key).children){if(label.visibility==View.GONE||label.value.isEmpty())continue;
     float[] size=DualHandLabelView.extent(label.value,paint);float w=size[0],h=size[1],x=(width-w)/2,y=(height-h)/2;
     int gravity=label.layout.gravity,margin=label.layout.margin;
     if((gravity&Gravity.LEFT)!=0)x=margin;if((gravity&Gravity.RIGHT)!=0)x=width-margin-w;
     if((gravity&Gravity.TOP)!=0)y=margin;if((gravity&Gravity.BOTTOM)!=0)y=height-margin-h;
     if(x<0||y<0||x+w>width||y+h>height)return false;
     for(float[] b:occupied)if(x<b[2]&&x+w>b[0]&&y<b[3]&&y+h>b[1])return false;
     occupied.add(new float[]{x,y,x+w,y+h});
    }
   }
  }return true;
 }
 @Test public void g_geometryAllStatesAtReferenceFont()throws Exception {
  float sp=fitLabelSize(400);assertTrue("all rendered states fit at "+sp,allRenderedLabelsFit(sp));
  assertFalse("next quarter-sp must fail, selected="+sp,allRenderedLabelsFit(sp+.25f));
  System.out.println("Reference font maximum/adopted="+sp+"sp; 26 states x 17 keys (letters plus function labels at 12sp); next="+(sp+.25f)+"sp does not fit");
 }
 @Test public void g_allLabelsFitOtherWidths()throws Exception {
  for(int width:new int[]{320,360,600,800}){float sp=fitLabelSize(width);assertTrue("minimum letter size at "+width,sp>=12);assertTrue("all states/functions fit at "+width,allRenderedLabelsFit(sp,width,columnWidths(width)));}
  for(String key:new String[]{"1","A"}){DualHandState.Stroke stroke=state.begin(key,100);state.end(stroke,"tap",false);state.drain(200);}assertTrue(state.applyAi("一"));renderLabels();assertEquals("還",labels.get("core").get("left").value);
 }
 @Test public void g_equalSizeBothHands()throws Exception {labelSizeSp=fitLabelSize(400);keys.clear();labels.clear();half(new String[][]{{"1","2"},{"3","4"},{"5","6"},{"A","B"},{"C","D"},{"E","F"},{"Ø"}});for(String key:new String[]{"1","2","3","4","5","6","A","B","C","D","E","F","Ø"}){float size=labels.get(key).get("tap").size;assertEquals(labelSizeSp,size,0);for(TextView v:labels.get(key).values())assertEquals(key,size,v.size,0);}}
}
class Context {static final int MODE_PRIVATE=0;static final String CLIPBOARD_SERVICE="clipboard";ClipboardManager cm=new ClipboardManager();Map<String,SharedPreferences> prefs=new HashMap<>();File dir;Context()throws IOException{dir=Files.createTempDirectory(Path.of("out"),"clipboard688-").toFile();}Object getSystemService(String s){return cm;}SharedPreferences getSharedPreferences(String n,int mode){return prefs.computeIfAbsent(n,k->new SharedPreferences());}File getFilesDir(){return dir;}File getExternalFilesDir(Object v){return dir;}}
class SharedPreferences {Map<String,String> map=new HashMap<>();float getFloat(String k,float d){return d;}String getString(String k,String d){return map.getOrDefault(k,d);}Editor edit(){return new Editor();}class Editor{Editor putString(String k,String v){map.put(k,v);return this;}void apply(){}}}
class ClipboardManager{ClipData clip;List<Runnable> listeners=new ArrayList<>();void addPrimaryClipChangedListener(Runnable l){listeners.add(l);}ClipData getPrimaryClip(){return clip;}void copy(String s,boolean sensitive){clip=new ClipData(s,sensitive);listeners.forEach(Runnable::run);}}
class ClipData{String text;boolean sensitive;ClipData(String s,boolean b){text=s;sensitive=b;}int getItemCount(){return 1;}Item getItemAt(int i){return new Item();}class Item{CharSequence getText(){return text;}}ClipDescription getDescription(){return new ClipDescription(sensitive);}}
class ClipDescription {static final String EXTRA_IS_SENSITIVE="android.content.extra.IS_SENSITIVE";boolean sensitive;ClipDescription(boolean b){sensitive=b;}CharSequence getLabel(){return "synthetic";}Extras getExtras(){return new Extras(sensitive);}}
class Extras{boolean sensitive;Extras(boolean b){sensitive=b;}boolean getBoolean(String key,boolean fallback){return sensitive;}}
class Log{static void i(String a,String b){}static void w(String a,String b,Throwable e){} }
