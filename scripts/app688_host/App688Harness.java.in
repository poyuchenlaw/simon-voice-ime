 @Test public void visualAllStatesAndHighlightDirections()throws Exception{
  for(String pending:DualHandTable.STATES){renderState=pending;renderLabels();for(String key:DualHandTable.RIGHT_KEYS)for(String dir:DualHandTable.DIRECTIONS){TextView v=labels.get(key).get(dir);boolean exists=!table.right(pending,key,dir).isEmpty();assertEquals(key+dir+pending,exists,v.visibility==View.VISIBLE);if(exists)assertEquals(color("hint"),v.tint);}}
  renderState=null;renderLabels();assertEquals(color("text"),labels.get("A").get("tap").tint);
  for(String dir:new String[]{"up","right","left","tap"}){Touch t=new Touch();t.stroke=state.begin("A",100);t.result=DualHandGesture.classify(dir.equals("right")?32:dir.equals("left")?-32:0,dir.equals("up")?-32:0,120,32);touches.put(1,t);renderLabels();assertEquals(!dir.equals("tap")&&!table.right(null,"A",t.result.direction).isEmpty()?1.15f:1,labels.get("A").get(t.result.direction).getScaleX(),.001);touches.clear();}
 }
 @Test public void landscapeGeometryUsesUniformHorizontalLabels()throws Exception{
  split=true;rowDp=50;labelSizeSp=fitLabelSize(800);renderLabels();assertTrue(labelSizeSp>=12);assertEquals(240,columnWidths(800)[0]);assertEquals(240,columnWidths(800)[1]);
  for(var parts:labels.values())for(var label:parts.values())assertFalse(label.value.contains("\n"));assertTrue("all states at 800x360",allRenderedLabelsFit(labelSizeSp,800,columnWidths(800)));
  System.out.println("landscape minimum="+labelSizeSp+"sp height=182dp wing=240dp gap=320dp left bottom=120dp each");
 }
 @Test public void thirtyRenderStepsMeasured()throws Exception{long[] ns=new long[30];for(int i=0;i<30;i++){renderState=DualHandTable.STATES[i%DualHandTable.STATES.length];long t=System.nanoTime();renderLabels();ns[i]=System.nanoTime()-t;}Arrays.sort(ns);System.out.println("HOST renderLabels 30 median_ms="+ns[15]/1e6+" p90_ms="+ns[26]/1e6+" max_ms="+ns[29]/1e6+"; not Android Canvas/frame time");}

 @Test public void g_equalSizeBothHands()throws Exception {labelSizeSp=fitLabelSize(400);keys.clear();labels.clear();half(new String[][]{{"1","2"},{"3","4"},{"5","6"},{"A","B"},{"C","D"},{"E","F"},{"Ø"}});for(String key:new String[]{"1","2","3","4","5","6","A","B","C","D","E","F","Ø"}){float size=labels.get(key).get("tap").size;assertEquals(labelSizeSp,size,0);for(TextView v:labels.get(key).values())assertEquals(key,size,v.size,0);}}
}
class Context {static final int MODE_PRIVATE=0;static final String CLIPBOARD_SERVICE="clipboard";ClipboardManager cm=new ClipboardManager();Map<String,SharedPreferences> prefs=new HashMap<>();File dir;Context()throws IOException{dir=Files.createTempDirectory(Path.of("out"),"clipboard688-").toFile();}Object getSystemService(String s){return cm;}SharedPreferences getSharedPreferences(String n,int mode){return prefs.computeIfAbsent(n,k->new SharedPreferences());}Thread owner=Thread.currentThread();volatile boolean recording;volatile int callerFileTouches;File getFilesDir(){if(recording&&Thread.currentThread()==owner)callerFileTouches++;return dir;}File getExternalFilesDir(Object v){if(recording&&Thread.currentThread()==owner)callerFileTouches++;return dir;}}
class SharedPreferences {Map<String,String> map=new HashMap<>();float getFloat(String k,float d){return d;}boolean getBoolean(String k,boolean d){return d;}String getString(String k,String d){return map.getOrDefault(k,d);}Editor edit(){return new Editor();}class Editor{Editor putString(String k,String v){map.put(k,v);return this;}void apply(){}boolean commit(){return true;}}}
class ClipboardManager{interface OnPrimaryClipChangedListener{void onPrimaryClipChanged();}ClipData clip;List<OnPrimaryClipChangedListener> listeners=new ArrayList<>();void addPrimaryClipChangedListener(OnPrimaryClipChangedListener l){listeners.add(l);}void removePrimaryClipChangedListener(OnPrimaryClipChangedListener l){listeners.remove(l);}ClipData getPrimaryClip(){return clip;}void copy(String s,boolean sensitive){clip=new ClipData(s,sensitive);new ArrayList<>(listeners).forEach(OnPrimaryClipChangedListener::onPrimaryClipChanged);}}
class ClipData{String text;boolean sensitive;ClipData(String s,boolean b){text=s;sensitive=b;}int getItemCount(){return 1;}Item getItemAt(int i){return new Item();}class Item{CharSequence getText(){return text;}}ClipDescription getDescription(){return new ClipDescription(sensitive);}}
class ClipDescription {static final String EXTRA_IS_SENSITIVE="android.content.extra.IS_SENSITIVE";boolean sensitive;ClipDescription(boolean b){sensitive=b;}CharSequence getLabel(){return "synthetic";}Extras getExtras(){return new Extras(sensitive);}}
class Extras{boolean sensitive;Extras(boolean b){sensitive=b;}boolean getBoolean(String key,boolean fallback){return sensitive;}}
class Log{static void i(String a,String b){}static void w(String a,String b,Throwable e){} }
